 tools/console/app.js     | 69 +++++++++++++++++++++++++++++-----------
 tools/console/index.html |  8 +++--
 tools/console/themes.js  |  3 +-
 tools/yue-server.cpp     | 62 +++++++++++++++++++++++++++++++-----
 5 files changed, 174 insertions(+), 29 deletions(-)

