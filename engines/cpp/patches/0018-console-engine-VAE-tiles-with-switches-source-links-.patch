diff --git a/tools/console/vaes.js b/tools/console/vaes.js
new file mode 100644
index 0000000..4e95772
--- /dev/null
+++ b/tools/console/vaes.js
@@ -0,0 +1,83 @@
+/* The Engine panel's VAE tiles: one per decoder, with where it came from
+   (official or third-party, and a link to it), a recap under its (i), and an
+   On/Off switch that picks it for the next song. A song has exactly one VAE,
+   so turning one on turns the others off; the form's VAE follows. The same
+   file ships in both consoles; each page hands it its decoders.
+
+   window.YueVaes:
+     listInto(list, note, opts)  opts: { current() -> name, choose(name) }
+     set(vaes, def)              [{name, label, repo, installed}] and the Engine default
+     setSources(map)             {name: {official, url, about}} from loras/sources.json
+     repaint()                   after the form's VAE changes */
+(function (root) {
+  "use strict";
+
+  var NOTES = { standard: "best sound", legacy: "benchmark", blend: "⅔ standard, ⅓ legacy" };
+  var S = { vaes: [], def: "", sources: {}, list: null, note: null, opts: {} };
+
+  function escape(text) {
+    return String(text === undefined || text === null ? "" : text).replace(/[&<>"']/g, function (c) {
+      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
+    });
+  }
+
+  function labelOf(v) { return v.label || v.name; }
+
+  function paint() {
+    if (!S.list) return;
+    var current = S.opts.current ? S.opts.current() : "", onLabel = "";
+    S.list.innerHTML = S.vaes.map(function (v) {
+      var src = S.sources[v.name] || {}, ok = v.installed !== false, on = ok && v.name === current;
+      var kind = src.official === true ? "official" : src.official === false ? "third-party" : "";
+      if (on) onLabel = labelOf(v);
+      var badge = kind ? '<span class="tile-kind' + (src.official ? "" : " is-third") + '" data-tip="' +
+          escape(src.official ? "Official: released by the model's own publisher"
+                              : "Third-party: made by someone else from the official releases, not by the model's publisher") +
+          '">' + kind + "</span>" : "";
+      var tags = (ok ? '<button type="button" class="lora-switch" data-vae-switch="' + escape(v.name) + '" aria-pressed="' + on + '" data-tip="' +
+          escape(on ? "On: the next song uses this VAE. A song needs one, so turn another on to switch"
+                    : "Off. Press to use this VAE for the next song (the form's VAE follows)") + '">' + (on ? "On" : "Off") + "</button>" : "");
+      var recap = [labelOf(v) + (kind ? " · " + kind : ""), src.about || "", v.repo ? "Weights: " + v.repo : ""].filter(Boolean).join("\n");
+      var where = src.url
+        ? '<a class="tile-link" href="' + escape(src.url) + '" target="_blank" rel="noopener noreferrer" data-tip="' +
+          escape("Open its model card (new tab): " + src.url) + '"><span>' + escape(v.repo || src.url) + "</span>\u2197</a>"
+        : '<span class="tile-repo" data-tip="' + escape(v.repo || v.name) + '">' + escape(v.repo || v.name) + "</span>";
+      var meta = [NOTES[v.name] || "", v.name === S.def ? "engine default" : "", ok ? "" : "not downloaded"].filter(Boolean).join(" · ");
+      return '<li class="lora-item vae-item' + (on ? " is-on" : "") + (src.official === false ? " is-third" : "") + (ok ? "" : " is-bad") + '">' +
+        '<div class="lora-item-head"><span class="lora-item-name">' + escape(labelOf(v)) + badge + '</span><span class="lora-item-tags">' + tags + "</span></div>" +
+        '<div class="tile-src">' + where + '<span class="info" tabindex="0" role="img" aria-label="About the ' + escape(labelOf(v)) +
+        ' VAE" data-tip="' + escape(recap) + '">i</span></div>' +
+        (meta ? '<div class="lora-item-meta">' + escape(meta) + "</div>" : "") + "</li>";
+    }).join("");
+    if (S.note) {
+      S.note.textContent = S.vaes.length + " decoder" + (S.vaes.length === 1 ? "" : "s") +
+        (onLabel ? " · " + onLabel + " on for the next song" : "") + " · a finished song can add another from its page";
+    }
+  }
+
+  function listInto(list, note, opts) {
+    S.list = list;
+    S.note = note || null;
+    S.opts = opts || {};
+    list.addEventListener("click", function (event) {
+      var button = event.target.closest("[data-vae-switch]");
+      if (!button || button.getAttribute("aria-pressed") === "true") return;
+      if (S.opts.choose) S.opts.choose(button.dataset.vaeSwitch);
+      paint();
+    });
+    paint();
+  }
+
+  function set(vaes, def) {
+    S.vaes = (vaes || []).slice();
+    S.def = def || "";
+    paint();
+  }
+
+  function setSources(map) {
+    S.sources = map && typeof map === "object" ? map : {};
+    paint();
+  }
+
+  root.YueVaes = { listInto: listInto, set: set, setSources: setSources, repaint: paint };
+})(window);
