+/* YuE2 Console for the C++ server — the same tape-machine console as the
+   PyTorch page, in warm near-black, with the score set on manuscript paper:
+   the one lit surface in an otherwise dark room. */
+
+/* Shape and type are shared; every colour lives in a theme below. */
+:root {
+  --r-sm: 4px;
+  --r-md: 7px;
+  --r-lg: 12px;
+  --playbar-h: 74px;
+
+  --sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
+  --mono: "IBM Plex Mono", "Cascadia Mono", ui-monospace, monospace;
+  --display: "Bodoni Moda", "Didot", "Times New Roman", serif;
+
+  /* The score is set on light manuscript paper in every theme. */
+  --paper:      #f2e9d5;
+  --paper-line: #d9cdb2;
+  --paper-ink:  #2a2318;
+}
+
+/* ------------------------------------------------------------------ themes */
