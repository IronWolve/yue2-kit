+
+* { box-sizing: border-box; }
+
+/* The page grows with what is open above the workspace (the Engine panel) and
+   leaves room under the fixed player, so it can always scroll to the end. */
+html { height: 100%; }
+
+body {
+  min-height: 100%;
+  padding-bottom: var(--playbar-h);
+  margin: 0;
+  background: var(--ground);
+  color: var(--ink);
+  font: 400 14px/1.55 var(--sans);
+  -webkit-font-smoothing: antialiased;
+}
+
+/* Faint horizontal grain, like the brushed face of a rack unit. */
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  z-index: 0;
+  background: repeating-linear-gradient(180deg, var(--grain) 0 1px, transparent 1px 3px);
+}
+
+button, input, select, textarea { font: inherit; color: inherit; }
+
+::selection { background: var(--amber-dim); color: #fff; }
+
+:focus-visible {
+  outline: 2px solid var(--amber);
+  outline-offset: 2px;
+  border-radius: var(--r-sm);
+}
+
+.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
+.is-hidden { display: none !important; }
+.spacer { flex: 1; }
+
+/* ------------------------------------------------------------------ shell */
+/* No side rail: the page is a workspace strip under a status bar, so a wide
+   screen shows the form, the running take and the library at the same time. */
+
+.topbar {
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  padding: 0 20px;
+  height: 52px;
+  background: var(--panel);
+  border-bottom: 1px solid var(--line);
+}
+
+.brand { display: flex; align-items: center; gap: 9px; flex: none; }
+.brand-mark { color: var(--amber); display: flex; }
+.brand h1 { margin: 0; font: 400 21px/1 var(--display); letter-spacing: .01em; }
+.brand h1 .two { color: var(--amber); }
+.engine-tag {
+  font: 500 9.5px/1 var(--mono);
+  letter-spacing: .08em;
+  text-transform: uppercase;
+  color: var(--patina);
+  border: 1px solid var(--patina-dim);
+  border-radius: 20px;
+  padding: 3px 7px;
+}
+
+.engine-chip { display: flex; gap: 9px; align-items: center; flex: none; }
+.engine-chip strong { display: block; font-size: 12.5px; font-weight: 600; line-height: 1.25; }
+.engine-chip small { display: block; font-size: 11px; color: var(--dim); line-height: 1.25; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.lamp { width: 8px; height: 8px; border-radius: 50%; background: var(--dim); flex: none; }
+.lamp[data-s="idle"]    { background: var(--good); box-shadow: 0 0 7px color-mix(in srgb, var(--good) 55%, transparent); }
+.lamp[data-s="loading"] { background: var(--amber); animation: pulse 1.1s ease-in-out infinite; }
+.lamp[data-s="busy"]    { background: var(--amber); box-shadow: 0 0 9px color-mix(in srgb, var(--amber) 70%, transparent); }
+.lamp[data-s="error"]   { background: var(--bad); }
+
+@keyframes pulse { 50% { opacity: .28; } }
+
+.hw-strip { display: flex; gap: 18px; margin: 0; font-size: 11px; min-width: 0; overflow: hidden; }
+.hw-strip div { display: flex; gap: 7px; align-items: baseline; white-space: nowrap; }
+.hw-strip dt { color: var(--dim); }
+.hw-strip dd { margin: 0; font-family: var(--mono); font-size: 10.5px; color: var(--muted); }
+
+/* engine settings drop down out of the bar rather than taking a whole screen */
+.engine-panel {
+  padding: 18px 20px;
+  background: var(--panel);
+  border-bottom: 1px solid var(--line);
+}
+/* The small cards share the first row and stretch to fill it; the log takes
+   a row of its own underneath. */
+.engine-grid { display: flex; flex-wrap: wrap; gap: 14px; align-items: stretch; }
+.engine-grid > .card { flex: 1 1 250px; min-width: 0; }
+.engine-grid > .card.writer-card { flex: 2 1 400px; }
+.engine-grid > .card.wide { flex-basis: 100%; }
+.engine-grid > .card.compute-card { flex: 1.3 1 300px; }
+.check-row { display: flex; align-items: center; gap: 2px; }
+.card.is-off .field, .card.is-off .check-row { opacity: .5; }
+.card-actions { margin-top: auto; }
+.card-actions { display: flex; gap: 8px; justify-content: flex-end; }
+
+/* the workspace: form, run, library, all live at once */
+.workspace {
+  display: grid;
+  /* compose | run | takes -- the takes column widens with the screen instead of
+     staying pinned at a fixed width. */
+  grid-template-columns:
+    minmax(500px, 760px)
+    minmax(420px, 1fr)
+    clamp(280px, 20vw, 560px);
+  gap: 1px;
+  background: var(--line);
+  height: calc(100vh - 52px - var(--playbar-h));
+}
+
+.col { background: var(--ground); overflow-y: auto; padding: 18px 22px 60px; display: flex; flex-direction: column; gap: 16px; }
+.compose-col { background: var(--ground); }
+.take-col { background: var(--take-bg); }
+/* Absolutely positioned bits inside a column (the hidden mode radios) must be
+   anchored to the column, or they stretch the page past the window and the
+   whole workspace scrolls up under the top bar. */
+.col, .library { position: relative; }
+
+.col-head {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  border-bottom: 1px solid var(--line);
+  position: sticky;
+  top: -18px;
+  z-index: 5;
+  margin: -18px -22px 0;
+  padding: 18px 22px 12px;
+  background: inherit;
+}
+.col-head h2 { margin: 0; font: 400 20px/1.2 var(--display); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.take-col .col-head { flex-wrap: wrap; row-gap: 8px; }
+.col-note { white-space: nowrap; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
+
+.head-actions { display: flex; gap: 7px; flex: none; align-items: center; }
+
+/* ---------------------------------------------------------------- buttons */
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 8px 14px;
+  border-radius: var(--r-md);
+  border: 1px solid var(--line);
+  background: var(--raise);
+  color: var(--ink);
+  font-size: 13px;
+  cursor: pointer;
+  text-decoration: none;
+  transition: border-color .13s ease, background .13s ease, transform .08s ease;
+}
+.btn:hover { border-color: var(--dim); background: var(--hover); }
+.btn:active { transform: translateY(1px); }
+.btn.ghost { background: transparent; color: var(--muted); }
+.btn.ghost:hover { color: var(--ink); }
+.btn.small { padding: 5px 10px; font-size: 12px; }
+.btn.danger:hover { color: var(--bad); border-color: var(--bad-line); }
+.btn.is-on { color: var(--amber); border-color: var(--amber-dim); }
+
+.btn.primary {
+  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
+  border-color: var(--amber-edge);
+  color: var(--on-amber);
+  font-weight: 600;
+}
+.btn.primary:hover { background: linear-gradient(180deg, var(--amber-hi2), var(--amber-hi)); }
+.btn[disabled] { opacity: .45; pointer-events: none; }
+.btn-glyph { font-size: 11px; }
+
+/* small drop-down menus (Save, library actions) */
+.menu-wrap { position: relative; flex: none; }
+.menu-pop {
+  position: absolute;
+  top: calc(100% + 6px);
+  left: 0;
+  z-index: 25;
+  min-width: 190px;
+  padding: 5px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  box-shadow: 0 14px 30px -12px var(--shadow-lg);
+}
+.menu-pop.right { left: auto; right: 0; }
+.menu-pop button {
+  padding: 7px 10px;
+  background: none;
+  border: 0;
+  border-radius: var(--r-sm);
+  color: var(--muted);
+  font-size: 12.5px;
+  text-align: left;
+  cursor: pointer;
+}
+.menu-pop button:hover, .menu-pop button:focus-visible { background: var(--hover); color: var(--ink); }
+.menu-pop button.danger:hover { color: var(--bad); }
+
+/* ------------------------------------------------------------------ forms */
+
+.compose { display: flex; flex-direction: column; gap: 16px; }
+.field { display: flex; flex-direction: column; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
+.field-row { display: flex; gap: 14px; align-items: flex-start; }
+.field-row.wrap { flex-wrap: wrap; row-gap: 12px; }
+.field-row.bottom { align-items: flex-end; }
+.grow { flex: 1; }
+.titlefield { min-width: 200px; }
+.seedfield { width: 212px; flex: none; }   /* room for a 19-digit seed */
+.row-hint { margin: -6px 0 0; font-size: 11.5px; color: var(--dim); max-width: 68ch; }
+
+.label {
+  font-size: 11px;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.label em { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--dim); margin-left: 8px; }
+
+input[type="text"], input[type="number"], textarea, select {
+  width: 100%;
+  padding: 9px 11px;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  color: var(--ink);
+  transition: border-color .13s ease, background .13s ease;
+}
+textarea { resize: vertical; line-height: 1.6; }
+textarea.mono { font-family: var(--mono); font-size: 12.5px; }
+input:hover, textarea:hover, select:hover { border-color: var(--line-strong); }
+input:focus, textarea:focus, select:focus { outline: 0; border-color: var(--amber); background: var(--focus-bg); }
+select:disabled { opacity: .7; }
+::placeholder { color: var(--placeholder); }
+
+#lyrics { font-family: var(--mono); font-size: 12.5px; }
+
+.seed-wrap { position: relative; }
+.seed-wrap input { padding-right: 38px; font-family: var(--mono); }
+
+.dice {
+  position: absolute;
+  right: 5px; top: 50%;
+  transform: translateY(-50%);
+  display: flex;
+  padding: 6px;
+  background: none;
+  border: 0;
+  border-radius: var(--r-sm);
+  color: var(--dim);
+  cursor: pointer;
+}
+.dice:hover { color: var(--amber); background: var(--raise); }
+
+/* modes: three switches on one plate */
+
+.modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
+.mode { cursor: pointer; }
+.mode input { position: absolute; opacity: 0; pointer-events: none; }
+
+.mode-body {
+  display: block;
+  height: 100%;
+  padding: 11px 12px;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-top: 2px solid var(--line);
+  border-radius: var(--r-md);
+  transition: border-color .13s ease, background .13s ease;
+}
+.mode-body strong { display: block; font-size: 13px; font-weight: 600; margin-bottom: 3px; }
+.mode-body small { display: block; font-size: 11px; line-height: 1.45; color: var(--dim); }
+.mode:hover .mode-body { border-color: var(--line-strong); }
+
+.mode input:checked + .mode-body {
+  background: var(--raise);
+  border-color: var(--line);
+  border-top-color: var(--amber);
+}
+.mode input:checked + .mode-body strong { color: var(--amber); }
+.mode input:checked + .mode-body small { color: var(--muted); }
+.mode input:focus-visible + .mode-body { outline: 2px solid var(--amber); outline-offset: 2px; }
+
+/* drawers */
+
+.drawer { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); }
+
+.drawer > summary {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  padding: 11px 13px;
+  cursor: pointer;
+  font-size: 13px;
+  list-style: none;
+  color: var(--ink);
+}
+.drawer > summary::-webkit-details-marker { display: none; }
+.summary-note { font-style: normal; font-size: 11.5px; color: var(--dim); margin-left: auto; }
+
+.chev {
+  width: 0; height: 0;
+  border-left: 5px solid var(--muted);
+  border-top: 4px solid transparent;
+  border-bottom: 4px solid transparent;
+  transition: transform .16s ease;
+}
+.drawer[open] > summary .chev { transform: rotate(90deg); }
+.drawer[open] > summary { border-bottom: 1px solid var(--line-soft); }
+
+.drawer-body { padding: 15px 13px; display: flex; flex-direction: column; gap: 13px; }
+.hint { margin: 0; font-size: 12px; color: var(--dim); max-width: 62ch; }
+
+.chiprow { display: flex; flex-wrap: wrap; gap: 7px; }
+
+.chip {
+  padding: 5px 10px;
+  background: var(--raise);
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  color: var(--muted);
+  font-size: 12px;
+  cursor: pointer;
+}
+.chip:hover { color: var(--ink); border-color: var(--patina-dim); }
+.chip.danger:hover { color: var(--bad); border-color: var(--bad-line); }
+.chip.static { cursor: default; }
+
+/* sampling knobs */
+
+.sampler-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
+.sampler h4 { margin: 0 0 10px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 7px; }
+.dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
+.dot.amber { background: var(--amber); }
+.dot.patina { background: var(--patina); }
+
+.knobs { display: grid; gap: 9px; }
+.knob { display: grid; grid-template-columns: 1fr 74px; gap: 9px; align-items: center; }
+.knob span { font-size: 12px; color: var(--dim); }
+.knob input { padding: 5px 8px; font-family: var(--mono); font-size: 12px; text-align: right; }
+.reset-cell { justify-content: flex-end; align-items: flex-start; padding-top: 22px; }
+
+.check { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--muted); cursor: pointer; }
+.check input { width: auto; accent-color: var(--amber); }
+.small-check { font-size: 12px; }
+
+/* sound and output: the C++ engine's own knobs */
+.out-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 14px; }
+.out-grid input, .out-grid select { font-family: var(--mono); font-size: 12.5px; }
+
+/* reused music codes: say plainly what Generate will do */
+.codes-note {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 12px;
+  background: color-mix(in srgb, var(--amber) 7%, var(--panel));
+  border: 1px solid var(--amber-dim);
+  border-radius: var(--r-md);
+  font-size: 12.5px;
+  color: var(--muted);
+}
+.codes-note > div { flex: 1; min-width: 0; }
+.codes-note strong { display: block; color: var(--amber); font-weight: 600; font-size: 12.5px; }
+
+/* submit */
+
+.submit-bar {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 15px 0 0;
+  border-top: 1px solid var(--line);
+}
+.submit-note { font-size: 12px; color: var(--dim); flex: 1; }
+
+/* ------------------------------------------------------------------- muse */
+/* The writer belongs to the symbolic side of the room, so it takes the patina
+   accent and leaves amber to the transport. */
+
+.muse {
+  margin-bottom: 20px;
+  padding: 15px 16px;
+  background: linear-gradient(180deg, color-mix(in srgb, var(--patina) 5%, transparent), transparent 70%), var(--panel);
+  border: 1px solid var(--line);
+  border-left: 2px solid var(--patina-dim);
+  border-radius: var(--r-lg);
+  display: flex;
+  flex-direction: column;
+  gap: 11px;
+}
+
+.muse-head { display: flex; align-items: center; gap: 10px; }
+
+.muse-tag {
+  font-size: 9.5px;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  color: var(--patina);
+  border: 1px solid var(--patina-dim);
+  border-radius: 20px;
+  padding: 2px 8px;
+}
+
+#museModel { width: auto; max-width: 260px; padding: 5px 9px; font-size: 12px; }
+
+.muse-row { display: flex; gap: 10px; align-items: flex-end; }
+.muse-row.secondary { max-width: 420px; }
+.muse-row.secondary select { padding: 6px 9px; font-size: 12.5px; }
+.muse-row input { flex: 1; }
+
+.btn.writer {
+  flex: none;
+  border-color: var(--patina-dim);
+  color: var(--patina);
+  background: color-mix(in srgb, var(--patina) 7%, transparent);
+}
+.btn.writer:hover { background: color-mix(in srgb, var(--patina) 14%, transparent); border-color: var(--patina); }
+.btn.writer[data-busy="1"] { pointer-events: none; opacity: .8; }
+.btn.writer[data-busy="1"] #museGlyph { display: inline-block; animation: spin 1.1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+.muse-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.muse-foot .check { font-size: 11.5px; color: var(--dim); }
+.muse .row-hint { margin: 0; }
+.muse-status { font-size: 11px; color: var(--patina); margin-left: auto; }
+.muse-status.bad { color: var(--bad); }
+
+/* The writer lives in a closed drawer; inside it the muse panel drops its own frame. */
+#museDrawer .muse { margin: 0; padding: 0; background: none; border: 0; border-radius: 0; }
+.col .col-head + .drawer { margin-top: 2px; }
+
+/* -------------------------------------------------------------- run chain */
+
+.chain {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 16px 18px;
+  margin-bottom: 22px;
+}
+
+.chain-head { display: flex; align-items: center; gap: 13px; margin-bottom: 15px; min-width: 0; }
+.run-what { font-size: 12px; color: var(--dim); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.run-state {
+  font-size: 10.5px;
+  letter-spacing: .16em;
+  text-transform: uppercase;
+  padding: 4px 9px;
+  border-radius: 20px;
+  border: 1px solid var(--line);
+  color: var(--muted);
+  flex: none;
+}
+.run-state[data-s="running"] { color: var(--amber); border-color: var(--amber-dim); }
+.run-state[data-s="done"] { color: var(--good); border-color: var(--good-line); }
+.run-state[data-s="failed"] { color: var(--bad); border-color: var(--bad-line); }
+.run-state[data-s="cancelled"] { color: var(--dim); }
+
+.run-clock { font-size: 15px; color: var(--ink); flex: none; }
+.run-seeds { margin: -6px 0 10px; font-size: 11px; color: var(--dim); overflow-wrap: anywhere; }
+.run-seeds:empty { display: none; }
+
+.stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
+
+.stage {
+  display: grid;
+  grid-template-columns: 20px 1fr auto;
+  gap: 12px;
+  align-items: center;
+  padding: 9px 4px;
+  border-radius: var(--r-sm);
+}
+.stage + .stage { border-top: 1px solid var(--line-soft); }
+
+.stage-num {
+  font: 500 10px/1 var(--mono);
+  color: var(--dim);
+  text-align: center;
+}
+
+.stage-main { min-width: 0; }
+.stage-label { font-size: 13px; display: flex; align-items: center; gap: 8px; }
+.stage-note { font-size: 11px; color: var(--dim); }
+
+.meter {
+  height: 3px;
+  margin-top: 7px;
+  background: var(--sunk);
+  border-radius: 2px;
+  overflow: hidden;
+}
+.meter i {
+  display: block;
+  height: 100%;
+  width: 0;
+  background: var(--amber);
+  transition: width .25s ease;
+}
+.meter.indeterminate i {
+  width: 34%;
+  background: linear-gradient(90deg, transparent, var(--amber), transparent);
+  animation: slide 1.35s linear infinite;
+}
+@keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
+
+.stage-read { font-family: var(--mono); font-size: 11.5px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.stage-read b { color: var(--ink); font-weight: 500; }
+
+.stage[data-s="waiting"] { opacity: .42; }
+.stage[data-s="running"] .stage-label { color: var(--amber); }
+.stage[data-s="completed"] .stage-num { color: var(--good); }
+.stage[data-s="failed"] .stage-label { color: var(--bad); }
+.stage[data-s="skipped"] { opacity: .3; }
+
+.run-error {
+  margin: 14px 0 0;
+  padding: 11px 13px;
+  background: color-mix(in srgb, var(--bad) 8%, transparent);
+  border: 1px solid var(--bad-line);
+  border-radius: var(--r-md);
+  font-family: var(--mono);
+  font-size: 12px;
+  color: var(--bad-ink);
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.take-empty {
+  padding: 34px 30px;
+  border: 1px dashed var(--line);
+  border-radius: var(--r-lg);
+  color: var(--dim);
+  max-width: 62ch;
+}
+.take-empty p { margin: 0; }
+.take-empty strong { color: var(--muted); }
+
+.take-body { display: flex; flex-direction: column; gap: 20px; }
+.take-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+
+/* ------------------------------------------------------------------ score */
+
+.score-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
+
+.score-tabs { display: flex; gap: 2px; padding: 2px; background: var(--sunk); border-radius: var(--r-sm); }
+
+.stab {
+  padding: 4px 11px;
+  background: none;
+  border: 0;
+  border-radius: 3px;
+  color: var(--dim);
+  font-size: 11.5px;
+  cursor: pointer;
+}
+.stab.is-active { background: var(--raise); color: var(--ink); }
+.stab:disabled { opacity: .45; cursor: not-allowed; }
+
+/* the manuscript inset: the one lit surface */
+.paper {
+  margin: 0;
+  padding: 18px 20px;
+  max-height: 460px;
+  overflow: auto;
+  background: var(--paper);
+  color: var(--paper-ink);
+  box-shadow: inset 0 1px 0 #fff8e8, inset 0 -14px 24px -18px rgba(60, 44, 18, .5);
+}
+pre.paper { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
+
+.paper svg { max-width: 100%; }
+.paper .abcjs-note, .paper .abcjs-staff, .paper path, .paper text { fill: var(--paper-ink); }
+.paper .abcjs-lyric { fill: #4a3d28; }
+
+/* --------------------------------------------------------------- metadata */
+
+.mini { margin: 0 0 7px; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
+
+/* ----------------------------------------------------------------- engine */
+
+.card {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 13px;
+}
+.card h3 { margin: 0; font: 400 16px/1 var(--display); }
+
+.kv { margin: 0; display: grid; gap: 8px; }
+.kv div { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; min-width: 0; }
+.kv dt { color: var(--dim); flex: none; }
+.kv dd { margin: 0; font-family: var(--mono); font-size: 12px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
+.kv dd.ok { color: var(--good); }
+.kv dd.no { color: var(--bad); }
+.kv dd.amber { color: var(--amber); }
+.kv.wrap dd { white-space: normal; overflow-wrap: anywhere; }
+
+.writer-pane {
+  padding: 12px;
+  background: var(--sunk);
+  border: 1px solid var(--line-soft);
+  border-radius: var(--r-md);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.pane-head { display: flex; align-items: center; gap: 9px; }
+.pane-head .mini { margin: 0; }
+.pane-head h3 { margin: 0; }
+
+.pill {
+  font-size: 9.5px;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  padding: 2px 8px;
+  border-radius: 20px;
+  border: 1px solid var(--line);
+  color: var(--dim);
+  white-space: nowrap;
+}
+.pill[data-s="ready"]   { color: var(--good); border-color: var(--good-line); }
+.pill[data-s="missing"] { color: var(--dim); }
+.pill[data-s="busy"]    { color: var(--amber); border-color: var(--amber-dim); }
+.pill[data-s="bad"]     { color: var(--bad); border-color: var(--bad-line); }
+
+/* the server's own console, streamed */
+.log-body {
+  height: 260px;
+  overflow: auto;
+  padding: 10px 12px;
+  background: var(--sunk);
+  border: 1px solid var(--line-soft);
+  border-radius: var(--r-md);
+  font-size: 11.5px;
+  line-height: 1.5;
+  color: var(--muted);
+}
+.log-line { white-space: pre-wrap; word-break: break-all; }
+.log-line.srv { color: var(--patina); }
+.log-line.good { color: var(--good); }
+.log-line.bad { color: var(--bad); }
+.log-line.dim { color: var(--dim); }
+.log-line .cut { color: var(--dim); }
+
+/* ---------------------------------------------------------------- library */
+
+.library { display: flex; flex-direction: column; background: var(--panel); overflow: hidden; }
+
+.lib-head {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 18px 14px 12px 18px;
+  border-bottom: 1px solid var(--line);
+}
+.lib-head h3 { margin: 0; font: 400 17px/1 var(--display); }
+.count { font-size: 11px; color: var(--dim); }
+
+.lib-toggle {
+  padding: 3px 9px;
+  background: none;
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  color: var(--dim);
+  font-size: 11px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+.lib-toggle:hover { color: var(--ink); border-color: var(--line-strong); }
+.lib-toggle[aria-pressed="true"] { color: var(--amber); border-color: var(--amber-dim); background: color-mix(in srgb, var(--amber) 10%, transparent); }
+
+.lib-list { flex: 1; overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
+
+.take {
+  position: relative;
+  padding: 11px 12px;
+  border: 1px solid transparent;
+  border-radius: var(--r-md);
+  cursor: pointer;
+  transition: background .13s ease, border-color .13s ease;
+}
+.take:hover { background: var(--raise); }
+.take.is-active { background: var(--raise); border-color: var(--line); box-shadow: inset 2px 0 0 var(--amber); }
+
+.take-title { font-size: 13.5px; font-weight: 500; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 48px; }
+.take-style { font-size: 11.5px; color: var(--dim); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+
+.take-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin-top: 7px; font-family: var(--mono); font-size: 10.5px; color: var(--dim); }
+
+.tag {
+  padding: 1px 6px;
+  border-radius: 3px;
+  border: 1px solid var(--line);
+  font-size: 9.5px;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+.tag.full { color: var(--patina); border-color: var(--patina-dim); }
+.tag.melody { color: var(--patina); border-color: var(--patina-dim); }
+.tag.off { color: var(--dim); }
+.tag.vae { color: var(--amber); border-color: var(--amber-dim); }
+.tag.re { color: var(--dim); border-style: dashed; }
+
+.take-del, .take-fav {
+  position: absolute;
+  top: 8px;
+  padding: 3px 6px;
+  background: var(--sunk);
+  border: 1px solid var(--line);
+  border-radius: var(--r-sm);
+  color: var(--dim);
+  font-size: 11px;
+  line-height: 1.2;
+  cursor: pointer;
+  opacity: 0;
+  transition: opacity .13s ease;
+}
+.take-del { right: 8px; }
+.take-fav { right: 38px; }
+.take:hover .take-del, .take:hover .take-fav, .take:focus-within .take-del, .take:focus-within .take-fav { opacity: 1; }
+.take-del:hover { color: var(--bad); border-color: var(--bad-line); }
+.take-fav:hover { color: var(--amber); border-color: var(--amber-dim); }
+.take.is-fav .take-fav { opacity: 1; color: var(--amber); border-color: var(--amber-dim); }
+
+.lib-empty { padding: 24px 14px; font-size: 12.5px; color: var(--dim); text-align: center; }
+
+/* ----------------------------------------------------------------- toasts */
+
+.toasts { position: fixed; right: 18px; bottom: calc(var(--playbar-h) + 14px); z-index: 40; display: flex; flex-direction: column; gap: 8px; }
+
+.toast {
+  padding: 11px 15px;
+  background: var(--raise);
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--amber);
+  border-radius: var(--r-md);
+  font-size: 13px;
+  max-width: 380px;
+  box-shadow: 0 12px 28px var(--shadow-md);
+  animation: rise .2s ease;
+}
+.toast.bad { border-left-color: var(--bad); }
+.toast.good { border-left-color: var(--good); }
+@keyframes rise { from { opacity: 0; transform: translateY(8px); } }
+
+/* ------------------------------------------------------------------ panels */
+
+.panel {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.panel-head { display: flex; align-items: baseline; gap: 10px; }
+.panel-head h3 { margin: 0; font: 400 16px/1 var(--display); }
+
+/* Prompt first, lyrics under it, both full width of the column. */
+.word-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-items: start; }
+
+/* lyrics scroll with the column; no inner box */
+.lyric-text {
+  margin: 0;
+  font: 400 13px/1.75 var(--mono);
+  color: var(--ink);
+  white-space: pre-wrap;
+}
+/* section tags carry the structure, so let them stand out */
+.lyric-text b { color: var(--patina); font-weight: 500; }
+
+.prompt-text { margin: 0; font-size: 13px; line-height: 1.6; color: var(--muted); }
+.prompt-text.dim { color: var(--dim); font-size: 12px; }
+.prompt-text:empty { display: none; }
+
+.meta-strip {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin: 0;
+}
+.meta-strip div {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  padding: 4px 9px;
+  background: var(--panel);
+  border: 1px solid var(--line-soft);
+  border-radius: 20px;
+  min-width: 0;
+}
+.meta-strip dt { font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
+.meta-strip dd { margin: 0; font-family: var(--mono); font-size: 11.5px; color: var(--ink); overflow-wrap: anywhere; }
+.meta-strip dd.warn { color: var(--amber); }
+
+/* rename in place: the title becomes a field */
+.title-edit {
+  flex: 1;
+  min-width: 180px;
+  max-width: 460px;
+  padding: 4px 9px !important;
+  font: 400 18px/1.2 var(--display) !important;
+}
+
+/* -------------------------------------------------------------- scrollbars */
+/* Thin and nearly invisible until the pointer is over the thing being
+   scrolled. Firefox takes scrollbar-width/-color; Chromium needs the
+   ::-webkit- rules, so both are declared. */
+
+* {
+  scrollbar-width: thin;
+  scrollbar-color: var(--line) transparent;
+}
+
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-corner { background: transparent; }
+
+::-webkit-scrollbar-thumb {
+  background: var(--line-soft);
+  border-radius: 8px;
+  /* Inset the thumb so it reads as a hairline rather than a bar. */
+  border: 2px solid transparent;
+  background-clip: content-box;
+}
+::-webkit-scrollbar-thumb:hover { background: var(--line); background-clip: content-box; }
+
+/* Columns always show their bar; inner boxes fade theirs in when you are there. */
+.paper, textarea, .log-body {
+  scrollbar-color: transparent transparent;
+  transition: scrollbar-color .25s ease;
+}
+.col, .lib-list { scrollbar-color: var(--line) transparent; }
+.col:hover, .lib-list:hover, .paper:hover, textarea:hover, .log-body:hover,
+.col:focus-within, .lib-list:focus-within, .paper:focus-within, textarea:focus-within {
+  scrollbar-color: var(--line) transparent;
+}
+
+.paper::-webkit-scrollbar-thumb,
+textarea::-webkit-scrollbar-thumb,
+.log-body::-webkit-scrollbar-thumb {
+  background: transparent;
+  background-clip: content-box;
+  transition: background .25s ease;
+}
+.col:hover::-webkit-scrollbar-thumb,
+.lib-list:hover::-webkit-scrollbar-thumb,
+.paper:hover::-webkit-scrollbar-thumb,
+textarea:hover::-webkit-scrollbar-thumb,
+.log-body:hover::-webkit-scrollbar-thumb {
+  background: var(--line);
+  background-clip: content-box;
+}
+
+/* The manuscript inset is light, so its bar has to darken instead. */
+.paper:hover { scrollbar-color: var(--paper-line) transparent; }
+.paper:hover::-webkit-scrollbar-thumb { background: var(--paper-line); background-clip: content-box; }
+
+/* ---------------------------------------------------------------- playbar */
+/* The transport belongs to the page, not to one column: it spans the full
+   width as the last row and stays put while every column scrolls. */
+
+.playbar {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 30;
+  height: var(--playbar-h);
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 0 18px;
+  background: var(--panel);
+  border-top: 1px solid var(--line);
+  box-shadow: 0 -14px 30px -24px var(--shadow-lg);
+}
+.playbar.is-empty { opacity: .55; }
+.playbar.is-empty .play, .playbar.is-empty .volume, .playbar.is-empty #dlAudio { pointer-events: none; }
+
+.playbar-id { flex: none; width: 200px; min-width: 0; }
+.playbar-id strong { display: block; font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.playbar-id small { display: block; font-size: 11px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.play {
+  width: 36px; height: 36px;
+  display: grid;
+  place-items: center;
+  flex: none;
+  border-radius: 50%;
+  border: 1px solid var(--amber-edge);
+  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
+  color: var(--on-amber);
+  font-size: 13px;
+  cursor: pointer;
+}
+.play:hover { filter: brightness(1.08); }
+
+.time { font-size: 12.5px; flex: none; }
+.time.dim { color: var(--dim); }
+
+#wave {
+  flex: 1;
+  min-width: 0;
+  display: block;
+  height: 40px;
+  cursor: pointer;
+  background: var(--sunk);
+  border: 1px solid var(--line);
+  border-radius: var(--r-sm);
+}
+
+.volume { display: flex; align-items: center; gap: 7px; flex: none; }
+
+.icon-btn {
+  background: none;
+  border: 0;
+  color: var(--muted);
+  font-size: 14px;
+  line-height: 1;
+  padding: 4px;
+  cursor: pointer;
+  border-radius: var(--r-sm);
+}
+.icon-btn:hover { color: var(--ink); background: var(--raise); }
+#libMenuBtn { font-size: 16px; padding: 2px 7px; }
+
+/* one slider, styled the same in both engines */
+#volume {
+  width: 92px;
+  height: 4px;
+  padding: 0;
+  border: 0;
+  border-radius: 3px;
+  background: var(--line);
+  appearance: none;
+  -webkit-appearance: none;
+  cursor: pointer;
+}
+#volume::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  width: 12px; height: 12px;
+  border-radius: 50%;
+  background: var(--amber);
+  border: 0;
+  cursor: pointer;
+}
+#volume::-moz-range-thumb {
+  width: 12px; height: 12px;
+  border-radius: 50%;
+  background: var(--amber);
+  border: 0;
+  cursor: pointer;
+}
+#volume:hover { background: var(--line-strong); }
+
+/* A plan-only run shows its score and nothing else. */
+.take-body.is-running .word-row,
+.take-body.is-running .meta-strip,
+.take-body.is-running .take-tools,
+.take-body.is-running .decode-switch { display: none; }
+
+/* ------------------------------------------------------------ back to run */
+/* Opening a finished take during a run must not strand you: this is the way
+   back, and it keeps working while the other song plays. */
+
+.run-return { flex: none; border-color: var(--amber-dim); color: var(--amber); }
+.run-return:hover { background: color-mix(in srgb, var(--amber) 10%, transparent); border-color: var(--amber); }
+
+.run-dot {
+  width: 7px; height: 7px;
+  border-radius: 50%;
+  background: var(--amber);
+  display: inline-block;
+  animation: pulse 1.1s ease-in-out infinite;
+}
+
+.take.is-running-row {
+  border-color: var(--amber-dim);
+  box-shadow: inset 2px 0 0 var(--amber);
+}
+.take.is-running-row .take-title { color: var(--amber); padding-right: 0; }
+
+/* ------------------------------------------------------ versions + shaping */
+.versions { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--dim); flex: none; }
+.versions input { width: 58px; padding: 6px 8px; }
+.shape { display: grid; gap: 10px; padding-bottom: 13px; border-bottom: 1px solid var(--line-soft); }
+.shape-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(110px, 1.2fr) 70px; align-items: center; gap: 12px; }
+.shape-name { font-size: 12.5px; color: var(--ink); }
+.shape-name em { display: block; font-style: normal; font-size: 11px; color: var(--dim); }
+.shape-row input[type="range"] { width: 100%; accent-color: var(--amber); }
+.shape-row output { font: 11px var(--mono); color: var(--muted); text-align: right; }
+.shape-row output.custom { color: var(--patina); }
+.shape-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.shape-foot .row-hint { margin: 0; }
+
+/* The file picker's button follows the ghost buttons instead of the browser's grey. */
+input[type="file"] { font-size: 12.5px; color: var(--muted); max-width: 100%; }
