+  margin-right: 10px; padding: 7px 12px; font: inherit; color: var(--ink); cursor: pointer;
+  background: transparent; border: 1px solid var(--line); border-radius: var(--r-md);
+  transition: background .13s ease, border-color .13s ease;
+}
+input[type="file"]::file-selector-button:hover { background: var(--raise); border-color: var(--line-strong); }
+
+/* Theme picker in the top bar. */
+.theme-pick { width: auto; padding: 5px 9px; font-size: 12px; }
+
+/* ------------------------------------------------------- decoders + sliders */
+fieldset.sound { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
+.toggles { display: flex; flex-wrap: wrap; gap: 8px; }
+.toggle {
+  display: inline-flex; align-items: baseline; gap: 7px; padding: 7px 11px; cursor: pointer; font-size: 13px;
+  border: 1px solid var(--line); border-radius: var(--r-md); background: var(--field);
+}
+.toggle small { font-size: 11px; color: var(--dim); }
+.toggle input { accent-color: var(--amber); margin: 0; align-self: center; }
+.toggle:has(input:checked) { border-color: var(--amber); background: color-mix(in srgb, var(--amber) 10%, var(--field)); }
+.toggle:has(input:disabled) { opacity: .5; cursor: not-allowed; }
+.slider-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip.is-on { border-color: var(--amber); color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent); }
+.chip.ghosted { border-style: dashed; color: var(--dim); }
+.chip:disabled { opacity: .45; cursor: not-allowed; }
+
+/* ------------------------------------------------------------ info tips */
+/* A small (i) beside a section says what kind of thing it is (VAE, plugin,
+   model); hovering it, or a button with a model behind it, shows the tip. */
+.info {
+  display: inline-grid;
+  place-items: center;
+  width: 15px; height: 15px;
+  margin-left: 6px;
+  vertical-align: 1px;
+  border: 1px solid var(--dim);
+  border-radius: 50%;
+  font: italic 600 10.5px/1 var(--display);
+  letter-spacing: 0;
+  text-transform: none;
+  color: var(--dim);
+  cursor: help;
+}
+.info:hover, .info:focus-visible { color: var(--amber); border-color: var(--amber); outline: none; }
+.tip {
+  position: fixed;
+  z-index: 50;
+  max-width: 320px;
+  padding: 7px 10px;
+  background: var(--panel);
+  color: var(--ink);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  box-shadow: 0 12px 30px -12px var(--shadow-lg);
+  font: 400 12px/1.5 var(--sans);
+  white-space: pre-line;
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity .12s ease, visibility .12s;
+}
+.tip.is-on { opacity: 1; visibility: visible; }
+.tip.tip-rich { max-width: 400px; padding: 11px 13px; white-space: normal; }
+.tip .tip-kind { display: block; margin-bottom: 6px; font: 600 10.5px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--amber); }
+.tip .tip-kind code { letter-spacing: 0; text-transform: none; color: var(--amber); }
+.tip p { margin: 0 0 7px; color: var(--muted); }
+.tip p:last-child { margin-bottom: 0; }
+.tip dl { margin: 0 0 7px; display: grid; grid-template-columns: auto 1fr; gap: 5px 12px; }
+.tip dt { color: var(--ink); font-weight: 500; }
+.tip dd { margin: 0; color: var(--muted); }
+.tip code { font: 400 11px/1.4 var(--mono); color: var(--ink); }
+.tip strong { color: var(--ink); font-weight: 600; }
+.slider-active { display: grid; gap: 6px; }
+.slider-active:empty { display: none; }
+.slider-row {
+  display: grid; grid-template-columns: minmax(84px, 130px) minmax(0, 1fr) 44px 30px; align-items: center; gap: 10px;
+  padding: 6px 8px 6px 12px; border: 1px solid var(--amber-dim); border-radius: var(--r-md); background: var(--field);
+}
+.slider-name { font-size: 13px; color: var(--ink); }
+.slider-row input[type="range"] { width: 100%; accent-color: var(--amber); }
+.slider-row output { font: 12px var(--mono); color: var(--muted); text-align: right; }
+.decode-switch { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.decode-switch:empty { display: none; }
+.decode-switch .label { margin: 0 4px 0 0; min-width: 44px; }
+
+/* ---------------------------------------------------------------- responsive */
+
+@media (max-width: 1500px) {
+  .workspace { grid-template-columns: minmax(380px, 1fr) minmax(380px, 1fr) 270px; }
+  .col { padding: 16px 16px 50px; }
+  .col-head { margin: -16px -16px 0; padding: 16px 16px 12px; }
+  .hw-strip { display: none; }
+  .playbar { gap: 10px; padding: 0 12px; }
+  .playbar-id { width: 150px; }
+  .out-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 1150px) {
+  .workspace { grid-template-columns: 1fr; height: auto; }
+  .col { max-height: none; }
+  .library { max-height: 420px; }
+  .modes, .sampler-grid { grid-template-columns: 1fr; }
+  .topbar { flex-wrap: wrap; height: auto; padding: 10px 14px; gap: 12px; }
+  .playbar { position: sticky; }
+  .playbar-id { display: none; }
+  #volume { width: 70px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
+}
