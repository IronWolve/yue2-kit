From 8d2261eb11211b664bbf8ef8e4a99a8bc6023c42 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Fri, 25 Sep 2026 21:20:35 -0700
Subject: [PATCH 15/55] Add 41 themes and a swatch picker

The top bar's theme menu becomes a swatch grid of 50 themes: the nine
hand-tuned ones plus 41 generated from compact palettes (23 Bold, 12 Soft,
6 more Classic). Every text colour of every theme clears 4.5:1 on every
surface it can sit on. Filters for All, Favorites, Bold, Soft and Classic,
a search, hover (or keyboard focus) to preview on the whole page, click to
keep, Esc to go back, a star to keep favourites, arrow keys through the
grid. themes.css and themes.js are shared by both consoles; the palettes
and the generator live outside the repository.
---
 tools/console/app.js     |   18 +-
 tools/console/index.html |    4 +-
 tools/console/themes.css | 1478 ++++++++++++++++++++++++++++++++++++++
 tools/console/themes.js  |  300 ++++++++
 4 files changed, 1787 insertions(+), 13 deletions(-)
 create mode 100644 tools/console/themes.css
 create mode 100644 tools/console/themes.js

diff --git a/tools/console/app.js b/tools/console/app.js
index d8e6522..1cbb88a 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -288,9 +288,6 @@
   /* -------------------------------------------------------------- themes */
   // The theme is applied in <head> before first paint; this is the picker.
   // Canvas drawing reads its colours from the active theme's CSS variables.
-  var THEMES = [["studio", "Studio (warm)"], ["graphite", "Graphite"], ["nord", "Nord"], ["dracula", "Dracula"],
-                ["gruvbox", "Gruvbox"], ["solarized-dark", "Solarized dark"], ["solarized-light", "Solarized light"],
-                ["daylight", "Daylight"], ["contrast", "High contrast"]];
   var themeCache = {};
 
   function themeRGB(name) {
@@ -307,18 +304,15 @@
     return "rgba(" + c[0] + "," + c[1] + "," + c[2] + "," + alpha + ")";
   }
 
-  (function () {
-    var pick = $("themePick"), current = document.documentElement.dataset.theme || "studio";
-    pick.innerHTML = THEMES.map(function (t) { return '<option value="' + t[0] + '">' + t[1] + "</option>"; }).join("");
-    pick.value = THEMES.some(function (t) { return t[0] === current; }) ? current : "studio";
-    pick.addEventListener("change", function () {
-      document.documentElement.dataset.theme = this.value;
-      store("yue2.theme", this.value);
+  // The theme picker (themes.js, shared with the other console): a preview or a change redraws
