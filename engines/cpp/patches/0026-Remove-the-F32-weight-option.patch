 tools/console/app.css    |  2 --
 tools/console/app.js     | 46 +++++++-------------------------
 tools/console/index.html | 15 -----------
 tools/yue-server.cpp     | 31 +++++-----------------
 6 files changed, 20 insertions(+), 133 deletions(-)

