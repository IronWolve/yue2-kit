   font: 500 9.5px/1 var(--mono);
@@ -1338,11 +1361,25 @@ textarea:hover::-webkit-scrollbar-thumb,
 }
 /* dim what is on the empty bar, not its background: pages scroll under it */
 .playbar.is-empty > * { opacity: .55; }
-.playbar.is-empty .play, .playbar.is-empty .volume, .playbar.is-empty #dlAudio { pointer-events: none; }
+.playbar.is-empty .play, .playbar.is-empty .volume { pointer-events: none; }
+
+/* the player bar's status: one fixed size whatever it says; a coloured dot for what is happening */
+.status-pill { display: inline-flex; flex: none; align-items: center; justify-content: center; gap: 7px; width: 104px; height: 28px;
+  border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font: 500 12px/1 var(--sans); cursor: default; }
+.status-pill:not([data-s="idle"]) { color: var(--ink); cursor: pointer; }
+.status-pill:not([data-s="idle"]):hover { border-color: var(--line-strong); }
+.status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
+.status-pill[data-s="rendering"] { border-color: var(--amber-dim); }
+.status-pill[data-s="rendering"] .status-dot { background: var(--amber); animation: status-pulse 1.4s ease-in-out infinite; }
+.status-pill[data-s="queued"] .status-dot { background: var(--amber-dim); }
+.status-pill[data-s="playing"] { border-color: var(--good-line); }
+.status-pill[data-s="playing"] .status-dot { background: var(--good); }
+.status-pill[data-s="paused"] .status-dot { background: var(--muted); }
+@keyframes status-pulse { 50% { opacity: .35; transform: scale(.75); } }
+@media (prefers-reduced-motion: reduce) { .status-pill .status-dot { animation: none; } }
 
 .playbar-id { flex: none; width: 200px; min-width: 0; }
 .playbar-id strong { display: block; font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
-.playbar-id small { display: block; font-size: 11px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 
 .play {
   width: 36px; height: 36px;
