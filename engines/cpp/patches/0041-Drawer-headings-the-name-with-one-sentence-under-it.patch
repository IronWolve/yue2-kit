From 5decf6b12c66e71840a54df7b62355dd48702e28 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:51:11 -0700
Subject: [PATCH 41/48] Drawer headings: the name, with one sentence under it

Each drawer's heading is its name on one line and a proper sentence under it (Sound and output keeps its live summary there), instead of a lower-case fragment pushed to the right that wrapped beside the name in a narrow column.
---
 tools/console/app.css    | 14 +++++++++-----
 tools/console/index.html | 12 ++++++------
 2 files changed, 15 insertions(+), 11 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index c5f48cd..98d8041 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -715,18 +715,22 @@ select:disabled { opacity: .7; }
 
 .drawer { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); }
 
+/* a drawer's heading: its name, and under it one sentence (or its live summary) that wraps under the
+   name in a narrow column, never beside it */
 .drawer > summary {
   display: flex;
-  align-items: center;
-  gap: 9px;
-  padding: 11px 13px;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 12px 14px;
   cursor: pointer;
-  font-size: 13px;
   list-style: none;
   color: var(--ink);
 }
 .drawer > summary::-webkit-details-marker { display: none; }
-.summary-note { font-style: normal; font-size: 11.5px; color: var(--dim); margin-left: auto; }
+.drawer > summary .chev { flex: none; margin-top: 6px; }
+.sum-head { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.sum-name { font-size: 13.5px; font-weight: 500; }
+.sum-say { font-size: 12px; line-height: 1.45; color: var(--dim); }
 
 .chev {
   width: 0; height: 0;
