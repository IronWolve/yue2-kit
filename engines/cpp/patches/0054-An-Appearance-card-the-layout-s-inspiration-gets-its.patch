+/* Appearance options, on <html> (the <head> script sets them before the first paint) */
+html[data-hover="accent"] {
+  --hover: color-mix(in srgb, var(--amber) 14%, transparent);
+  --hover-soft: color-mix(in srgb, var(--amber) 9%, transparent);
+  --hover-line: color-mix(in srgb, var(--amber) 55%, transparent);
+}
+html[data-corners="soft"] { --r-sm: 3px; --r-md: 5px; --r-lg: 8px; }
+html[data-corners="square"] { --r-sm: 1px; --r-md: 2px; --r-lg: 3px; }
+html[data-glow="on"] :is(.card, .drawer, .panel, .meta-card) {
+  box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 22%, transparent), 0 10px 30px -16px color-mix(in srgb, var(--amber) 50%, transparent);
+}
+html[data-motion="reduced"] *, html[data-motion="reduced"] *::before, html[data-motion="reduced"] *::after {
+  animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important;
+}
 .check-row { display: flex; align-items: center; gap: 2px; }
 .card.is-off .field, .card.is-off .check-row { opacity: .5; }
 .card-actions { margin-top: auto; display: flex; gap: 8px; justify-content: flex-end; }
