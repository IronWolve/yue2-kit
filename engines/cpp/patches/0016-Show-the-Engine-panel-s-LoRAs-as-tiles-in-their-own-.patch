-.card h3.card-sub { margin-top: 18px; }
+/* Engine panel: every LoRA in loras/ as a small tile, under the VAEs */
+.lora-card-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
+.lora-card-note { color: var(--dim); font-size: 12px; }
+.lora-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 8px; }
+.lora-item { min-width: 0; padding: 8px 10px; background: var(--sunk); border: 1px solid var(--line-soft); border-left: 3px solid var(--line-strong);
+  border-radius: var(--r-sm); }
+.lora-item.is-on { border-left-color: var(--amber); }
+.lora-item.is-bad { border-left-color: var(--bad); }
+.lora-item-head { display: flex; align-items: flex-start; gap: 8px; }
+.lora-item-name { flex: 1; min-width: 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere; }
+.lora-item-tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; flex: none; max-width: 55%; }
+.lora-item-meta { margin-top: 4px; font: 11px/1.45 var(--mono); color: var(--dim); overflow-wrap: anywhere; }
+.lora-item.is-bad .lora-item-meta { color: var(--bad); }
+.tag.in-use { color: var(--amber); border-color: var(--amber-dim); }
 
