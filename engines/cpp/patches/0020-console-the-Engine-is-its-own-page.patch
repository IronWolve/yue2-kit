From 3b6ba362b4f339a15339383707454a42187060f1 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Sat, 26 Sep 2026 09:01:45 -0700
Subject: [PATCH 20/50] console: the Engine is its own page

Opening the Engine now sets the song workspace aside instead of dropping the
panel above it, so it is never mistaken for Compose: a band names it (a gear,
Engine, what it holds) and stays pinned under the top bar with a Back to
compose button, the backdrop is dotted, the cards sit tighter, and the top
bar's Engine button stays lit while it is open. It is all keyed off the panel
itself, so the button, Back and Escape look the same. The empty player bar
now dims only its contents, so pages scrolling under it no longer show
through.
---
 tools/console/app.css    | 33 +++++++++++++++++++++++++++------
 tools/console/app.js     |  1 +
 tools/console/index.html |  5 +++++
 3 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 7c73797..2fcb1e7 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -441,12 +441,32 @@ button, input, select, textarea { font: inherit; color: inherit; }
 .hw-strip dt { color: var(--dim); }
 .hw-strip dd { margin: 0; font-family: var(--mono); font-size: 10.5px; color: var(--muted); }
 
-/* engine settings drop down out of the bar rather than taking a whole screen */
+/* The Engine is its own page, never mistaken for Compose: the song workspace steps aside while it
+   is open, a band names it (and stays in view), the backdrop is dotted and the cards sit tighter;
+   the top bar's Engine button stays lit. Keyed off the panel itself, so every way of opening or
+   closing it (the button, Back, Escape) looks the same. */
+body:has(#view-engine:not(.is-hidden)) .workspace { display: none; }
+body:has(#view-engine:not(.is-hidden)) #engineToggle { background: var(--amber); border-color: var(--amber); color: var(--on-amber); }
 .engine-panel {
-  padding: 18px 20px;
-  background: var(--panel);
-  border-bottom: 1px solid var(--line);
-}
+  min-height: calc(100vh - 52px - var(--playbar-h));
+  padding: 0 20px 24px;
+  background-color: var(--sunk);
+  background-image: radial-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1.3px);
+  background-size: 16px 16px;
+  border-bottom: 0;
+}
+.engine-head {
+  position: sticky; top: 52px; z-index: 6;
+  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
+  margin: 0 -20px 16px; padding: 10px 20px;
+  background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: inset 0 3px 0 var(--amber);
+}
+.engine-title { margin: 0; font: 400 21px/1 var(--display); color: var(--amber); white-space: nowrap; }
+.engine-gear { font-size: 17px; vertical-align: 1px; }
+.engine-sub { margin: 0; color: var(--dim); font-size: 12px; }
+#engineBack { margin-left: auto; }
+.engine-panel .card { padding: 13px 14px; gap: 10px; }
+.engine-panel .engine-grid { gap: 12px; }
 /* The small cards share the first row and stretch to fill it; the log takes
    a row of its own underneath. */
 .engine-grid { display: flex; flex-wrap: wrap; gap: 14px; align-items: stretch; }
@@ -1278,7 +1298,8 @@ textarea:hover::-webkit-scrollbar-thumb,
   border-top: 1px solid var(--line);
   box-shadow: 0 -14px 30px -24px var(--shadow-lg);
 }
-.playbar.is-empty { opacity: .55; }
+/* dim what is on the empty bar, not its background: pages scroll under it */
+.playbar.is-empty > * { opacity: .55; }
 .playbar.is-empty .play, .playbar.is-empty .volume, .playbar.is-empty #dlAudio { pointer-events: none; }
 
 .playbar-id { flex: none; width: 200px; min-width: 0; }
diff --git a/tools/console/app.js b/tools/console/app.js
index 0079293..f1d2b60 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -196,6 +196,7 @@
   }
 
   $("engineToggle").addEventListener("click", function () { show("engine"); });
+  $("engineBack").addEventListener("click", function () { $("view-engine").classList.add("is-hidden"); });
 
   function closeMenus() {
     all(".menu-pop").forEach(function (menu) { menu.classList.add("is-hidden"); });
diff --git a/tools/console/index.html b/tools/console/index.html
index e9e33d0..d276326 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -67,6 +67,11 @@ Make more copies with repo/build/quantize (see AGENTS.md)."></select>
 
 <!-- ---------------------------------------------------------------- engine -->
 <section class="engine-panel is-hidden" id="view-engine">
+  <div class="engine-head">
+    <h2 class="engine-title"><span class="engine-gear" aria-hidden="true">&#9881;</span> Engine</h2>
+    <p class="engine-sub">models, decoders, add-ons and this machine &middot; settings here apply to every song until you change them</p>
+    <button type="button" class="btn ghost small" id="engineBack" data-tip="Back to the song form (Esc)">&larr; Back to compose</button>
+  </div>
   <div class="engine-grid">
     <div class="card">
       <h3>Server</h3>
