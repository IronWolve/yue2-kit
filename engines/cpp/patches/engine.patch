+.tool-group { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
+.tool-cap { font: 600 10px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
+.tool-row { display: flex; flex-wrap: wrap; gap: 6px; }
+.split-btn { display: inline-flex; }
+.split-btn > .btn:not(.is-hidden) { border-top-right-radius: 0; border-bottom-right-radius: 0; }
+.split-btn > .btn:not(.is-hidden) + .mp3-rate { border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none; }
+
+/* Favourite, Rename, Delete: small icons on the title line; the line under the title on its own row */
+.head-actions .icon-act { min-width: 30px; justify-content: center; font-size: 14px; }
+.head-actions .icon-act.danger { color: var(--bad); border-color: var(--bad-line); }
+.head-actions .icon-act svg { display: block; }
+.take-col #takeEyebrow { order: 20; flex-basis: 100%; white-space: normal; }
+
+/* ------------------------------------------------------------------ score */
+
+.score-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
+
+.score-tabs { display: flex; gap: 2px; padding: 2px; background: var(--sunk); border-radius: var(--r-sm); }
+
+.stab {
+  padding: 4px 11px;
+  background: none;
+  border: 0;
+  border-radius: 3px;
