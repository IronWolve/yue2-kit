diff --git a/tests/test-companion.cpp b/tests/test-companion.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b4c707d1a506916ad29f9c46c1873efd4fea4b9c
--- /dev/null
+++ b/tests/test-companion.cpp
@@ -0,0 +1,54 @@
+// CPU-only check using a real v9 bundle and GGUF metadata; no model inference.
+#include "gguf-weights.h"
+#include <cstdio>
+#include <cmath>
+
+int main(int argc, char **argv) {
+    if (argc != 3) { fprintf(stderr, "usage: test-companion model.gguf bundle.safetensors\n"); return 2; }
+    GGUFModel gf{};
+    if (!gf_load(&gf, argv[1])) return 2;
+    int checks = 0;
+    for (auto strengths : {std::pair<double,double>{0.7,0.7}, {0.2,0.2}, {0.7,0.0}, {0.0,0.0}}) {
+        LoraSet set;
+        std::string error;
+        if (!lora_set_open({{argv[2],strengths.first,strengths.second}}, &set, &error) ||
+            !lora_bind(&set,gf_lora_rows,&gf,&error)) { fprintf(stderr,"%s\n",error.c_str()); return 1; }
+        bool active = strengths.first != 0 || strengths.second != 0;
+        if (active == set.sig[1].empty()) return 1;
+        for (const auto &entry : set.index) for (const auto &c : entry.second) {
+            double want = c.group->companion ? (active ? 1.0 : 0.0) : c.group->half ? strengths.second : strengths.first;
+            if (c.strength != want) { fprintf(stderr,"bad companion/style strength\n"); return 1; }
+        }
+        if (!active && !set.index.empty()) return 1;
+        for (const char *name : {"model.layers.0.nar_self_attn.q_proj.weight", "llm2vae.weight", "vae2llm.weight"}) {
+            int64_t cols=0, rows=gf_lora_rows(&gf,name,&cols);
+            std::vector<LoraPrepared> prepared;
+            if (!lora_prepare(&set,name,rows,cols,&prepared,&error)) return 1;
+            std::vector<float> base((size_t)cols,0.25f), actual=base;
+            lora_apply_rows(prepared,actual.data(),base.data(),0,1,cols);
+            for (int64_t col=0; col<std::min<int64_t>(cols,16); ++col) {
+                double expected=base[(size_t)col];
+                for (const auto &c : set.index[name]) {
+                    const auto &g=*c.group;
+                    double strength=g.companion ? 1.0 : g.half ? strengths.second : strengths.first;
+                    std::vector<float> a,b,d;
+                    if (g.kind==LoraGroup::LORA) {
+                        if (!st_read_f32(c.file->st,g.a,&a,&error) || !st_read_f32(c.file->st,g.b,&b,&error)) return 1;
+                        double scale=g.scale;
+                        if (!g.alpha.empty()) { if (!st_read_f32(c.file->st,g.alpha,&d,&error)||d.size()!=1) return 1; scale=(double)d[0]/(double)g.rank; }
+                        for (int64_t k=0;k<g.rank;k++) expected+=strength*scale*b[(size_t)(c.row0*g.rank+k)]*a[(size_t)(k*cols+col)];
+                    } else {
+                        if (!st_read_f32(c.file->st,g.key,&d,&error)) return 1;
+                        expected+=strength*(d[(size_t)(c.row0*cols+col)]-(g.kind==LoraGroup::REPLACE?base[(size_t)col]:0.0));
+                    }
+                }
+                if (!std::isfinite(actual[(size_t)col]) || std::abs(actual[(size_t)col]-expected)>1e-4*(1+std::abs(expected))) {
+                    fprintf(stderr,"merge mismatch %s col %lld\n",name,(long long)col); return 1;
+                }
+                checks++;
+            }
+        }
+    }
+    gf_close(&gf);
+    printf("PASS %d numerical companion/style checks; zero strength disables the whole bundle\n",checks);
+}
diff --git a/tests/test-kit-request.cpp b/tests/test-kit-request.cpp
