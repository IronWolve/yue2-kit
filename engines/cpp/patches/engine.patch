+.tag.re { color: var(--dim); border-style: dashed; }
+
+.take-del, .take-fav, .take-dl, .take-mp3 {
+  position: absolute;
+  top: 8px;
+  padding: 3px 6px;
+  background: var(--sunk);
+  border: 1px solid var(--line);
