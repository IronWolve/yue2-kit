+  color: var(--dim);
+  font-size: 11px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+.lib-toggle:hover { color: var(--ink); border-color: var(--hover-line, var(--line-strong)); }
+.lib-toggle[aria-pressed="true"] { color: var(--amber); border-color: var(--amber-dim); background: color-mix(in srgb, var(--amber) 10%, transparent); }
+
+.lib-list { flex: 1; overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
+
+.take {
+  position: relative;
+  padding: 11px 12px;
+  border: 1px solid transparent;
+  border-radius: var(--r-md);
