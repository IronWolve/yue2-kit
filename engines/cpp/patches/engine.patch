+        fprintf(stderr, "[LoRA] FATAL: %s\n", g_gf_lora_error.c_str());
+        unload(m);
+        return false;
+    }
+    if (ok && k.lora) {
+        fprintf(stderr, "[LoRA] Merged while loading (%.0f ms in all)\n", t.ms());
+    }
+    return ok;
+}
