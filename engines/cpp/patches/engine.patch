+  var FONT_ROLES = {
+    sans: { select: "fontSans", generic: "sans-serif", own: "IBM Plex Sans" },
+    heading: { select: "fontHeading", generic: "sans-serif", own: "" },
+    mono: { select: "fontMono", generic: "monospace", own: "IBM Plex Mono" }
