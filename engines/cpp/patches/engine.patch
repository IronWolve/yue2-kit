+.take-del { right: 8px; }
+.take-fav { right: 38px; }
+.take-dl { right: 68px; text-decoration: none; }
+.take:hover .take-del, .take:hover .take-fav, .take:focus-within .take-del, .take:focus-within .take-fav,
+.take:hover .take-dl, .take:focus-within .take-dl, .take:hover .take-mp3, .take:focus-within .take-mp3 { opacity: 1; }
+.take:hover .take-title, .take:focus-within .take-title { padding-right: 132px; }
+.take-dl:hover { color: var(--amber); border-color: var(--amber-dim); }
+.take-mp3 { right: 98px; font-size: 10.5px; text-decoration: none; }
+.take-mp3:hover { color: var(--amber); border-color: var(--amber-dim); }
+.mp3-rate {
+  width: auto;
+  flex: none;
+  padding: 4px 8px;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-radius: var(--r-sm);
+  color: var(--muted);
+  font-size: 12px;
+}
+.take-del:hover { color: var(--bad); border-color: var(--bad-line); }
+.take-fav:hover { color: var(--amber); border-color: var(--amber-dim); }
+.take.is-fav .take-fav { opacity: 1; color: var(--amber); border-color: var(--amber-dim); }
+
+.lib-empty { padding: 24px 14px; font-size: 12.5px; color: var(--dim); text-align: center; }
+
+/* ----------------------------------------------------------------- toasts */
+
+.toasts { position: fixed; right: 18px; bottom: calc(var(--playbar-h) + 14px); z-index: 40; display: flex; flex-direction: column; gap: 8px; }
+
+.toast {
+  padding: 11px 15px;
+  background: var(--raise);
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--amber);
+  border-radius: var(--r-md);
+  font-size: 13px;
+  max-width: 380px;
+  box-shadow: 0 12px 28px var(--shadow-md);
+  animation: rise .2s ease;
+}
+.toast.bad { border-left-color: var(--bad); }
+.toast.good { border-left-color: var(--good); }
+@keyframes rise { from { opacity: 0; transform: translateY(8px); } }
+
+/* ------------------------------------------------------------------ panels */
+
+.panel {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.panel-head { display: flex; align-items: baseline; gap: 10px; }
+.panel-head h3 { margin: 0; font: 500 15px/1.35 var(--heading); }
+
+/* Prompt first, lyrics under it, both full width of the column. */
+.word-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-items: start; }
+
+/* lyrics scroll with the column; no inner box */
+.lyric-text {
+  margin: 0;
+  font: 400 13px/1.75 var(--mono);
+  color: var(--ink);
+  white-space: pre-wrap;
+}
+/* section tags carry the structure, so let them stand out */
+.lyric-text b { color: var(--patina); font-weight: 500; }
+
+.prompt-text { margin: 0; font-size: 13px; line-height: 1.6; color: var(--muted); }
+.prompt-text.dim { color: var(--dim); font-size: 12px; }
+.prompt-text:empty { display: none; }
+
+/* the song's details: one compact card. Song | Sound | Shape, then Sliders | LoRAs, then the seeds */
+.meta-card { border: 1px solid var(--line); border-radius: 10px; background: var(--panel); container-type: inline-size; }
+.meta-row { display: grid; padding: 10px 0; border-top: 1px solid var(--line-soft); }
+.meta-row:first-child { border-top: none; }
+.meta-row.trio { grid-template-columns: auto auto minmax(0, 1fr); }
+.meta-row.duo { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
+.meta-row.seeds { padding: 10px 14px; }
+.meta-col { min-width: 0; padding: 0 14px; border-left: 1px solid var(--line-soft); }
+.meta-col:first-child { border-left: none; }
+.meta-col h4 { margin: 0 0 6px; font: 600 10px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
+.meta-rows { display: grid; grid-template-columns: auto auto; justify-content: start; align-items: baseline; gap: 5px 8px; margin: 0; }
+.meta-rows > div { display: contents; }
+.meta-rows dt { color: var(--muted); font-size: 12.5px; }
+.meta-rows dd { margin: 0; min-width: 0; color: var(--ink); font-size: 13.5px; font-weight: 500; white-space: nowrap; }
+.meta-rows dd.num { font-family: var(--mono); font-size: 12.5px; }
+.meta-rows dd.warn { color: var(--amber); }
+.meta-rows.addons { gap: 5px 12px; }
+.meta-rows.addons .name { color: var(--ink); font-size: 13.5px; font-weight: 500; overflow-wrap: anywhere; }
+.meta-rows.addons .amt { color: var(--muted); font: 12px/1.35 var(--mono); white-space: nowrap; }
+.meta-rows.addons .none { color: var(--dim); font-size: 12.5px; }
+.meta-rows.seeds { grid-template-columns: auto auto auto; gap: 4px 10px; }
+.dots { display: inline-flex; gap: 4px; margin-right: 8px; }
+.dots i { width: 8px; height: 8px; border: 1px solid var(--amber-dim); border-radius: 50%; }
+.dots i.on { background: var(--amber); border-color: var(--amber); }
+.dots.custom i { border-style: dashed; }
+.meta-card .bar { position: relative; display: inline-block; width: 36px; height: 3px; margin-right: 6px; overflow: hidden;
+  border-radius: 2px; background: var(--line-soft); vertical-align: middle; }
+.meta-card .bar b { position: absolute; inset: 0 auto 0 0; background: var(--amber); }
+.seed-copy { padding: 0 4px; border: none; background: transparent; color: var(--dim); font-size: 13px; line-height: 1; cursor: pointer; }
+.seed-copy:hover { color: var(--ink); }
+/* narrower than this card was designed for: Shape drops under Song | Sound, then Sliders over LoRAs */
+@container (max-width: 500px) {
+  .meta-row.trio { grid-template-columns: auto minmax(0, 1fr); row-gap: 10px; }
+  .meta-row.trio > .meta-col:last-child { grid-column: 1 / -1; padding-top: 10px; border-left: none; border-top: 1px solid var(--line-soft); }
+}
+@container (max-width: 380px) {
+  .meta-row.duo { grid-template-columns: minmax(0, 1fr); row-gap: 10px; }
+  .meta-row.duo > .meta-col + .meta-col { border-left: none; }
+}
+
+
+/* rename in place: the title becomes a field */
+.title-edit {
+  flex: 1;
+  min-width: 180px;
+  max-width: 460px;
+  padding: 4px 9px !important;
+  font: 500 17px/1.2 var(--heading) !important;
+}
+
+/* -------------------------------------------------------------- scrollbars */
+/* Thin and nearly invisible until the pointer is over the thing being
+   scrolled. Firefox takes scrollbar-width/-color; Chromium needs the
+   ::-webkit- rules, so both are declared. */
+
+* {
+  scrollbar-width: thin;
+  scrollbar-color: var(--line) transparent;
+}
+
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-corner { background: transparent; }
+
+::-webkit-scrollbar-thumb {
+  background: var(--line-soft);
+  border-radius: 8px;
+  /* Inset the thumb so it reads as a hairline rather than a bar. */
+  border: 2px solid transparent;
+  background-clip: content-box;
+}
+::-webkit-scrollbar-thumb:hover { background: var(--line); background-clip: content-box; }
+
+/* Columns always show their bar; inner boxes fade theirs in when you are there. */
+.paper, textarea, .log-body {
+  scrollbar-color: transparent transparent;
+  transition: scrollbar-color .25s ease;
+}
+.col, .lib-list { scrollbar-color: var(--line) transparent; }
+.col:hover, .lib-list:hover, .paper:hover, textarea:hover, .log-body:hover,
+.col:focus-within, .lib-list:focus-within, .paper:focus-within, textarea:focus-within {
+  scrollbar-color: var(--line) transparent;
+}
+
+.paper::-webkit-scrollbar-thumb,
+textarea::-webkit-scrollbar-thumb,
+.log-body::-webkit-scrollbar-thumb {
+  background: transparent;
+  background-clip: content-box;
+  transition: background .25s ease;
+}
+.col:hover::-webkit-scrollbar-thumb,
+.lib-list:hover::-webkit-scrollbar-thumb,
+.paper:hover::-webkit-scrollbar-thumb,
+textarea:hover::-webkit-scrollbar-thumb,
+.log-body:hover::-webkit-scrollbar-thumb {
+  background: var(--line);
+  background-clip: content-box;
+}
+
+/* The manuscript inset is light, so its bar has to darken instead. */
+.paper:hover { scrollbar-color: var(--paper-line) transparent; }
+.paper:hover::-webkit-scrollbar-thumb { background: var(--paper-line); background-clip: content-box; }
+
+/* ---------------------------------------------------------------- playbar */
+/* The transport belongs to the page, not to one column: it spans the full
+   width as the last row and stays put while every column scrolls. */
+
+.playbar {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 30;
+  height: var(--playbar-h);
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 0 18px;
+  background: var(--panel);
+  border-top: 1px solid var(--line);
+  box-shadow: 0 -14px 30px -24px var(--shadow-lg);
+}
+/* dim what is on the empty bar, not its background: pages scroll under it */
+.playbar.is-empty > * { opacity: .55; }
+.playbar.is-empty .play, .playbar.is-empty .volume { pointer-events: none; }
+
+/* the player bar's status: one fixed size whatever it says; a coloured dot for what is happening */
+.status-pill { display: inline-flex; flex: none; align-items: center; justify-content: center; gap: 7px; width: 104px; height: 28px;
+  border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font: 500 12px/1 var(--sans); cursor: default; }
+.status-pill:not([data-s="idle"]) { color: var(--ink); cursor: pointer; }
+.status-pill:not([data-s="idle"]):hover { border-color: var(--hover-line, var(--line-strong)); }
+.status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
+.status-pill[data-s="rendering"] { border-color: var(--amber-dim); }
+.status-pill[data-s="rendering"] .status-dot { background: var(--amber); animation: status-pulse 1.4s ease-in-out infinite; }
+.status-pill[data-s="queued"] .status-dot { background: var(--amber-dim); }
+.status-pill[data-s="playing"] { border-color: var(--good-line); }
+.status-pill[data-s="playing"] .status-dot { background: var(--good); }
+.status-pill[data-s="paused"] .status-dot { background: var(--muted); }
+@keyframes status-pulse { 50% { opacity: .35; transform: scale(.75); } }
+@media (prefers-reduced-motion: reduce) { .status-pill .status-dot { animation: none; } }
+
+.playbar-id { flex: none; width: 200px; min-width: 0; }
+.playbar-id strong { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
+  font-size: 12px; line-height: 1.3; font-weight: 500; overflow-wrap: anywhere; }
+
+.play {
+  width: 36px; height: 36px;
+  display: grid;
+  place-items: center;
+  flex: none;
+  border-radius: 50%;
+  border: 1px solid var(--amber-edge);
+  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
+  color: var(--on-amber);
+  font-size: 13px;
+  cursor: pointer;
+}
+.play:hover { box-shadow: 0 0 0 3px color-mix(in srgb, var(--amber) 32%, transparent); }
+.play-icon { display: none; }
+
+/* the DMM theme's play button: a purple ring on a 10% purple tint, drawn play and pause icons, stronger
+   on hover, pressed in on click */
+[data-theme="dmm"] .play {
+  width: 48px; height: 48px;
+  border: 1px solid rgb(var(--accent-rgb) / .3);
+  background: rgb(var(--accent-rgb) / .1);
+  color: rgb(var(--accent-rgb));
+  transition: background-color .15s, border-color .15s, transform .15s;
+}
+[data-theme="dmm"] .play:hover { box-shadow: none; background: rgb(var(--accent-rgb) / .2); border-color: rgb(var(--accent-rgb) / .5); }
+[data-theme="dmm"] .play:active { transform: scale(.95); }
+[data-theme="dmm"] #playGlyph { display: none; }
+[data-theme="dmm"] .play-icon { width: 20px; height: 20px; fill: currentColor; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+[data-theme="dmm"] .play:not(.is-playing) .play-icon-play { display: block; margin-left: 2px; }
+[data-theme="dmm"] .play.is-playing .play-icon-pause { display: block; }
+
+.time { font-size: 12.5px; flex: none; }
+.time.dim { color: var(--dim); }
+
+#wave {
+  flex: 1;
+  min-width: 0;
+  display: block;
+  height: 40px;
+  cursor: pointer;
+  background: var(--sunk);
+  border: 1px solid var(--line);
+  border-radius: var(--r-sm);
+}
+
+.volume { display: flex; align-items: center; gap: 7px; flex: none; }
+
+.icon-btn {
+  background: none;
+  border: 0;
+  color: var(--muted);
+  font-size: 14px;
+  line-height: 1;
+  padding: 4px;
+  cursor: pointer;
+  border-radius: var(--r-sm);
+}
+.icon-btn:hover { color: var(--ink); background: var(--hover-soft, var(--raise)); }
+#libMenuBtn { font-size: 16px; padding: 2px 7px; }
+
+/* one slider, styled the same in both engines */
+#volume {
+  width: 92px;
+  height: 4px;
+  padding: 0;
+  border: 0;
+  border-radius: 3px;
+  background: var(--line);
+  appearance: none;
+  -webkit-appearance: none;
+  cursor: pointer;
+}
+#volume::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  width: 12px; height: 12px;
+  border-radius: 50%;
+  background: var(--amber);
+  border: 0;
+  cursor: pointer;
+}
+#volume::-moz-range-thumb {
+  width: 12px; height: 12px;
+  border-radius: 50%;
+  background: var(--amber);
+  border: 0;
+  cursor: pointer;
+}
+#volume:hover { background: var(--line-strong); }
+
+/* A plan-only run shows its score and nothing else. */
+.take-body.is-running .word-row,
+.take-body.is-running .meta-card,
+.take-body.is-running .take-tools,
+.take-body.is-running .decode-switch { display: none; }
+
+/* ------------------------------------------------------------ back to run */
+/* Opening a finished take during a run must not strand you: this is the way
+   back, and it keeps working while the other song plays. */
+
+.run-return { flex: none; border-color: var(--amber-dim); color: var(--amber); }
+.run-return:hover { background: color-mix(in srgb, var(--amber) 10%, transparent); border-color: var(--amber); }
+
+.run-dot {
+  width: 7px; height: 7px;
+  border-radius: 50%;
+  background: var(--amber);
+  display: inline-block;
+  animation: pulse 1.1s ease-in-out infinite;
+}
+
+.take.is-running-row {
+  border-color: var(--amber-dim);
+  box-shadow: inset 2px 0 0 var(--amber);
+}
+.take.is-running-row .take-title { color: var(--amber); padding-right: 0; }
+
+/* ------------------------------------------------------ versions + shaping */
+.versions { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--dim); flex: none; }
+.versions input { width: 62px; height: 32px; padding: 0 8px; }
+.shape { display: grid; gap: 10px; padding-bottom: 13px; border-bottom: 1px solid var(--line-soft); }
+.shape-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(110px, 1.2fr) 70px; align-items: center; gap: 12px; }
+.shape-name { font-size: 12.5px; color: var(--ink); }
+.shape-name em { display: block; font-style: normal; font-size: 11px; color: var(--dim); }
+.shape-row input[type="range"] { width: 100%; accent-color: var(--amber); }
+.shape-row output { font: 11px var(--mono); color: var(--muted); text-align: right; }
+.shape-row output.custom { color: var(--patina); }
+.shape-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.shape-foot .row-hint { margin: 0; }
+
+/* The file picker's button follows the ghost buttons instead of the browser's grey. */
+input[type="file"] { font-size: 12.5px; color: var(--muted); max-width: 100%; }
+input[type="file"]::file-selector-button {
+  margin-right: 10px; padding: 7px 12px; font: inherit; color: var(--ink); cursor: pointer;
+  background: transparent; border: 1px solid var(--line); border-radius: var(--r-md);
+  transition: background .13s ease, border-color .13s ease;
+}
+input[type="file"]::file-selector-button:hover { background: var(--hover-soft, var(--raise)); border-color: var(--hover-line, var(--line-strong)); }
+
+/* Theme picker in the top bar. */
+.theme-pick { width: auto; padding: 5px 9px; font-size: 12px; }
+
+/* ------------------------------------------------------- decoders + sliders */
+fieldset.sound { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
+.toggles { display: flex; flex-wrap: wrap; gap: 8px; }
+.toggle {
+  display: inline-flex; align-items: baseline; gap: 7px; padding: 7px 11px; cursor: pointer; font-size: 13px;
+  border: 1px solid var(--line); border-radius: var(--r-md); background: var(--field);
+}
+.toggle small { font-size: 11px; color: var(--dim); }
+.toggle input { accent-color: var(--amber); margin: 0; align-self: center; }
+.toggle:has(input:checked) { border-color: var(--amber); background: color-mix(in srgb, var(--amber) 10%, var(--field)); }
+.toggle:has(input:disabled) { opacity: .5; cursor: not-allowed; }
+.slider-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip.is-on { border-color: var(--amber); color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent); }
+.chip.ghosted { border-style: dashed; color: var(--dim); }
+.chip:disabled { opacity: .45; cursor: not-allowed; }
+
+/* ------------------------------------------------------------ info tips */
+/* A small (i) beside a section says what kind of thing it is (VAE, plugin,
+   model); hovering it, or a button with a model behind it, shows the tip. */
+.info {
+  display: inline-grid;
+  place-items: center;
+  width: 15px; height: 15px;
+  margin-left: 6px;
+  vertical-align: 1px;
+  border: 1px solid var(--dim);
+  border-radius: 50%;
+  font: italic 600 10.5px/1 var(--display);
+  letter-spacing: 0;
+  text-transform: none;
+  color: var(--dim);
+  cursor: help;
+}
+.info:hover, .info:focus-visible { color: var(--amber); border-color: var(--amber); }
+.tip {
+  position: fixed;
+  z-index: 50;
+  max-width: min(480px, calc(100vw - 16px));   /* wide enough that a tip's lines stay whole */
+  padding: 7px 10px;
+  background: var(--panel);
+  color: var(--ink);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  box-shadow: 0 12px 30px -12px var(--shadow-lg);
+  font: 400 12px/1.5 var(--sans);
+  white-space: pre-line;
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity .12s ease, visibility .12s;
+}
+.tip.is-on { opacity: 1; visibility: visible; }
+.tip.tip-rich { max-width: min(520px, calc(100vw - 16px)); padding: 11px 13px; white-space: normal; }
+.tip .tip-kind { display: block; margin-bottom: 6px; font: 600 10.5px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--amber); }
+.tip .tip-kind code { letter-spacing: 0; text-transform: none; color: var(--amber); }
+.tip p { margin: 0 0 7px; color: var(--muted); }
+.tip p:last-child { margin-bottom: 0; }
+.tip dl { margin: 0 0 7px; display: grid; grid-template-columns: auto 1fr; gap: 5px 12px; }
+.tip dt { color: var(--ink); font-weight: 500; }
+.tip dd { margin: 0; color: var(--muted); }
+.tip code { font: 400 11px/1.4 var(--mono); color: var(--ink); }
+.tip strong { color: var(--ink); font-weight: 600; }
+.slider-active { display: grid; gap: 6px; }
+.slider-active:empty { display: none; }
+.slider-row {
+  display: grid; grid-template-columns: minmax(84px, 130px) minmax(0, 1fr) 44px 30px; align-items: center; gap: 10px;
+  padding: 6px 8px 6px 12px; border: 1px solid var(--amber-dim); border-radius: var(--r-md); background: var(--field);
+}
+.slider-name { font-size: 13px; color: var(--ink); }
+.slider-row input[type="range"] { width: 100%; accent-color: var(--amber); }
+.slider-row output { font: 12px var(--mono); color: var(--muted); text-align: right; }
+.decode-switch { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.decode-switch:empty { display: none; }
+.decode-switch .label { margin: 0 4px 0 0; min-width: 44px; }
+
+/* ---------------------------------------------------------------- responsive */
+
+@media (max-width: 1500px) {
+  .workspace { grid-template-columns: var(--col-left, minmax(380px, 1fr)) minmax(380px, 1fr) var(--col-right, 270px); }
+  .col { padding: 16px 16px 50px; }
+  .col-head { margin: -16px -16px 0; padding: 16px 16px 12px; }
+  .playbar { gap: 10px; padding: 0 12px; }
+  .playbar-id { width: 150px; }
+  .out-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 1150px) {
+  .workspace { grid-template-columns: 1fr; height: auto; }
+  .col-grip { display: none; }
+  .library { max-height: 420px; }
+  .engine-head { position: static; }
+  body { padding-bottom: 0; }
+  .modes, .sampler-grid { grid-template-columns: 1fr; }
+  .topbar { flex-wrap: wrap; height: auto; padding: 10px 14px; gap: 12px; }
+  .playbar { position: sticky; }
+  .playbar-id { display: none; }
+  #volume { width: 70px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
+}
+
+/* instrumental switch under the planning modes */
+.instrumental-check { margin-top: 10px; align-items: center; gap: 8px; }
+.instrumental-check .info { margin-left: 2px; }
+
+/* LoRAs: one row per active LoRA, a strength for each half */
+.lora-active { display: grid; gap: 6px; margin-bottom: 6px; }
+.lora-active:empty { display: none; }
+.lora-row {
+  display: grid; grid-template-columns: minmax(90px, 1fr) minmax(120px, 1.1fr) minmax(120px, 1.1fr) auto 30px;
+  align-items: center; gap: 10px;
+  padding: 6px 8px 6px 12px; border: 1px solid var(--amber-dim); border-radius: var(--r-md); background: var(--field);
+}
+.lora-row.is-missing { border-style: dashed; opacity: .6; }
+.lora-name { font-size: 13px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.lora-half { display: grid; grid-template-columns: auto minmax(0, 1fr) 34px; align-items: center; gap: 6px; font-size: 11px; color: var(--dim); }
+.lora-half input[type="range"] { width: 100%; accent-color: var(--amber); }
+.lora-half output { font: 12px var(--mono); color: var(--muted); text-align: right; }
+.lora-half.is-off { opacity: .4; }
+.lora-trigger { font-size: 11px; padding: 3px 8px; }
+.lora-hint { margin-top: 8px; }
+@media (max-width: 720px) {
+  .lora-row { grid-template-columns: minmax(0, 1fr) 30px; }
+  .lora-row .lora-half, .lora-row .lora-trigger { grid-column: 1 / -1; }
+}
+
+/* copy icon in the Prompt card's corner */
+.panel-head .copy-icon { align-self: center; color: var(--dim); }
+.panel-head .copy-icon:hover, .panel-head .copy-icon:focus-visible { color: var(--amber); }
+
+/* Engine panel: every LoRA in loras/ as a small tile, under the VAEs */
+.lora-card-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
+.lora-card-note { color: var(--dim); font-size: 12px; }
+.lora-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 8px; }
+.lora-item { min-width: 0; padding: 8px 10px; background: var(--sunk); border: 1px solid var(--line-soft); border-left: 3px solid var(--line-strong);
+  border-radius: var(--r-sm); }
+.lora-item.is-on { border-left-color: var(--amber); }
+.lora-item.is-bad { border-left-color: var(--bad); }
+.lora-item-head { display: flex; align-items: flex-start; gap: 8px; }
+.lora-item-name { flex: 1; min-width: 0; font-size: 13px; color: var(--ink); overflow-wrap: anywhere; }
+.lora-item-meta { margin-top: 4px; font: 11px/1.45 var(--mono); color: var(--dim); overflow-wrap: anywhere; }
+.lora-item.is-bad .lora-item-meta { color: var(--bad); }
+
+/* the form's LoRA buttons: one even grid; each shows its name, the half it steers and a few words */
+.lora-chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 6px; }
+.lora-pick { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 1px 8px; min-width: 0;
+  padding: 6px 10px 7px; text-align: left; background: var(--sunk); border: 1px solid var(--line-soft); border-radius: var(--r-sm);
+  color: var(--ink); cursor: pointer; }
+.lora-pick:hover, .lora-pick:focus-visible { border-color: var(--amber-dim); background: var(--hover); outline: none; }
+.lora-pick.is-on { border-color: var(--amber); box-shadow: inset 3px 0 0 var(--amber); }
+.lora-pick:disabled { cursor: not-allowed; opacity: .55; border-style: dashed; }
+.lora-pick-name { min-width: 0; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.lora-pick-half { font: 600 9.5px/1.4 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
+.lora-pick.is-on .lora-pick-half { color: var(--amber); }
+.lora-pick-tag { grid-column: 1 / -1; min-width: 0; font-size: 11.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.lora-pick:disabled .lora-pick-tag { color: var(--bad); }
+
+/* Engine tiles: the source link and the (i) recap under each name; official or third-party VAEs */
+.tile-src { display: flex; align-items: center; gap: 2px; margin-top: 3px; min-width: 0; }
+.tile-link, .tile-repo { min-width: 0; font: 11.5px/1.45 var(--mono); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.tile-link { display: inline-flex; gap: 3px; color: var(--patina); text-decoration: none; }
+.tile-link span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.tile-link:hover, .tile-link:focus-visible { color: var(--amber); outline: none; }
+.tile-link:hover span, .tile-link:focus-visible span { text-decoration: underline; }
+.tile-src .info { flex: none; }
+/* STOCK (shipped with the model by its publisher) or ADD-ON (made by someone else): the same small mark everywhere */
+.kind-badge { display: inline-block; margin-left: 8px; padding: 0 6px; vertical-align: 2px; border: 1px solid var(--line-strong); border-radius: 999px;
+  color: var(--muted); font: 600 9.5px/1.5 var(--sans); font-style: normal; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; cursor: help; }
+.kind-badge.is-addon { border-style: dashed; border-color: var(--amber-dim); color: var(--amber); }
+.label .kind-badge { margin-left: 4px; }
+.toggle .kind-badge { margin-left: 6px; vertical-align: 1px; }
+.vae-item.is-addon { border-style: dashed; border-left-style: solid; }
+.card-src { margin: -4px 0 10px; }
+.tile-state { flex: none; margin-top: 2px; font: 600 9.5px/1.5 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--amber); white-space: nowrap; }
+.slider-list { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
+.slider-item .lora-item-meta { font: 12px/1.45 var(--sans); color: var(--muted); }
+
+/* the style box grows with its text; the meter under it counts the prompt against the context */
+#style { field-sizing: content; min-height: 76px; max-height: 50vh; }
+.size-meter { display: block; margin: 4px 0 0; }
+.size-meter.is-warn { color: var(--amber); }
+.size-meter.is-over { color: var(--bad); }
+
+/* the take the player is playing stands out in the list: a card tinted in the theme's accent, a thicker
+   accent bar than the selected card's, an accent title and a solid ▶ PLAYING badge */
+.tag.playing-tag { display: none; }
+.take.is-playing { background: color-mix(in srgb, var(--amber) 14%, transparent); border-color: var(--amber-dim); box-shadow: inset 4px 0 0 var(--amber); }
+.take.is-playing:hover { background: color-mix(in srgb, var(--amber) 22%, transparent); }
+.take.is-playing .take-title { color: var(--amber); font-weight: 600; }
+.take.is-playing .tag.playing-tag { display: inline-block; background: var(--amber); border-color: var(--amber); color: var(--on-amber); font-weight: 700; }
+.take.is-playing .tag.playing-tag::before { content: "▶ "; }
+
+/* a seed box with a seed in it: its dice clears it */
+.dice.is-set { color: var(--amber); }
+
