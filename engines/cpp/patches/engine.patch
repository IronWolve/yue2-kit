+
+* { box-sizing: border-box; }
+
+/* The page grows with what is open above the workspace (the Engine panel) and
+   leaves room under the fixed player, so it can always scroll to the end. */
+html { height: 100%; }
+
+body {
+  min-height: 100%;
+  padding-bottom: var(--playbar-h);
+  margin: 0;
+  background: var(--ground);
+  color: var(--ink);
+  font: 400 14px/1.55 var(--sans);
+  -webkit-font-smoothing: antialiased;
+}
+
+button, input, select, textarea { font: inherit; color: inherit; }
+
+::selection { background: var(--amber); color: var(--on-amber); }
+
+:focus-visible {
+  outline: 2px solid var(--amber);
+  outline-offset: 2px;
+  border-radius: var(--r-sm);
+}
+
+.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
+.is-hidden { display: none !important; }
+.spacer { flex: 1; }
+
+/* ------------------------------------------------------------------ shell */
+/* No side rail: the page is a workspace strip under a status bar, so a wide
+   screen shows the form, the running take and the library at the same time. */
+
+.topbar {
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  padding: 0 20px;
+  height: 52px;
+  background: var(--panel);
+  border-bottom: 1px solid var(--line);
+}
+
+.brand { display: flex; align-items: center; gap: 9px; flex: none; }
+.brand-mark { color: var(--amber); display: flex; text-decoration: none; border-radius: var(--r-sm, 4px); transition: color .12s ease, transform .12s ease; }
+.brand-mark:hover, .brand-mark:focus-visible { color: var(--ink); transform: translateY(-1px); }   /* the collection's repo */
+.brand h1 { margin: 0; font: 400 21px/1 var(--display); letter-spacing: .01em; }
+.brand h1 .two { color: var(--amber); }
+.brand-link { color: inherit; text-decoration: none; }   /* the model's repo */
+
+/* About, at the bottom of the Engine page: the credit, then every project this app is built on */
+.about-card { display: flex; flex-direction: column; gap: 14px; }
+.about-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
+.about-credit { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0; color: var(--muted); font-size: 13px; }
+.about-credit strong { color: var(--ink); font-weight: 600; }
+.about-gh { color: var(--muted); font: 12px var(--mono); text-decoration: none; border-bottom: 1px solid var(--line); }
+.about-gh:hover { color: var(--ink); border-color: var(--line-strong); }
+.about-kit { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
+.about-kit:hover, .about-kit:focus-visible { text-decoration-color: var(--amber); }
+/* two bands: the three projects (the model, the engine, the tensor library), then the add-ons */
+.about-grid { display: flex; flex-direction: column; gap: 16px; container-type: inline-size; }
+.about-projects, .about-addons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; }
+/* two columns: the model on the left, the engine, the layout and the tensor library stacked on the right */
+.about-projects { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 28px; }
+.about-projects > .about-project:first-child { grid-row: span 3; }
+.about-addons { padding-top: 14px; border-top: 1px solid var(--line-soft); }
+.about-project h4 { margin: 0; font: 500 15px/1.2 var(--heading); color: var(--ink); letter-spacing: 0; text-transform: none; }
+.about-what { margin: 2px 0 9px; color: var(--muted); font-size: 12px; }
+.about-addons h4 { margin: 0 0 7px; font: 600 10px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
+@container (max-width: 760px) { .about-projects, .about-addons { grid-template-columns: minmax(0, 1fr); } .about-projects > .about-project:first-child { grid-row: auto; } }
+.about-links { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
+.about-links li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; min-width: 0; }
+.about-links a, .about-links .about-name { color: var(--ink); font-size: 13.5px; font-weight: 500; text-decoration: none; }
+.about-links a::after { content: " \2197"; color: var(--dim); font-size: 11px; }
+.about-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
+.about-where { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
+.about-none { color: var(--dim); font-size: 12.5px; }
+.brand-link:hover, .brand-link:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
+.engine-tag {
+  font: 500 9.5px/1 var(--mono);
+  letter-spacing: .08em;
+  text-transform: uppercase;
+  color: var(--patina);
+  border: 1px solid var(--patina-dim);
+  border-radius: 20px;
+  padding: 3px 7px;
+  text-decoration: none;   /* a link to the engine's repo */
+}
+.engine-tag:hover, .engine-tag:focus-visible { color: var(--ink); border-color: var(--line-strong); }
+
+.engine-chip { display: flex; gap: 9px; align-items: center; flex: none; }
+.engine-chip strong { display: block; font-size: 12.5px; font-weight: 600; line-height: 1.25; }
+.engine-chip small { display: block; font-size: 11px; color: var(--dim); line-height: 1.25; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.lamp { width: 8px; height: 8px; border-radius: 50%; background: var(--dim); flex: none; }
+.lamp[data-s="idle"]    { background: var(--good); box-shadow: 0 0 7px color-mix(in srgb, var(--good) 55%, transparent); }
+.lamp[data-s="loading"] { background: var(--amber); animation: pulse 1.1s ease-in-out infinite; }
+.lamp[data-s="busy"]    { background: var(--amber); box-shadow: 0 0 9px color-mix(in srgb, var(--amber) 70%, transparent); }
+.lamp[data-s="error"]   { background: var(--bad); }
+
+@keyframes pulse { 50% { opacity: .28; } }
+
+/* the GPU readout: two small lines (GPU, VRAM) that fit a small screen; its tip has the rest */
+.hw-strip { display: grid; gap: 1px; margin: 0; font-size: 10.5px; line-height: 1.3; min-width: 0; flex: none; cursor: default; }
+.head-actions .hw-strip { margin-right: 6px; }
+.hw-strip div { display: flex; gap: 6px; align-items: baseline; white-space: nowrap; }
+.hw-strip dt { color: var(--dim); min-width: 32px; }
+.hw-strip dd { margin: 0; font-family: var(--mono); font-size: 10px; color: var(--muted); }
+
+/* The Engine is its own page, never mistaken for Compose: the song workspace steps aside while it
+   is open, a band names it (and stays in view), the backdrop is dotted and the cards sit tighter;
+   the top bar's Engine button stays lit. Keyed off the panel itself, so every way of opening or
+   closing it (the button, Back, Escape) looks the same. */
+body:has(#view-engine:not(.is-hidden)) .workspace { display: none; }
+body:has(#view-engine:not(.is-hidden)) #engineToggle { background: var(--amber); border-color: var(--amber); color: var(--on-amber); }
+.engine-panel {
+  min-height: calc(100vh - 52px - var(--playbar-h));
+  padding: 0 20px 24px;
+  background-color: var(--sunk);
+  background-image: radial-gradient(color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1.3px);
+  background-size: 16px 16px;
+  border-bottom: 0;
+}
+.engine-head {
+  position: sticky; top: 52px; z-index: 6;
+  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
+  margin: 0 -20px 16px; padding: 10px 20px;
+  background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: inset 0 3px 0 var(--amber);
+}
+.engine-title { margin: 0; font: 500 19px/1.35 var(--heading); color: var(--amber); white-space: nowrap; }
+.engine-gear { font-size: 17px; vertical-align: 1px; }
+.engine-sub { margin: 0; color: var(--dim); font-size: 12px; }
+#engineBack { margin-left: auto; }
+.engine-panel .card { padding: 13px 14px; gap: 10px; }
+.engine-panel .engine-grid { gap: 12px; }
+/* The small cards share the first row and stretch to fill it; the log takes
+   a row of its own underneath. */
+.engine-grid { display: flex; flex-wrap: wrap; gap: 14px; align-items: stretch; }
+.engine-grid > .card { flex: 1 1 250px; min-width: 0; }
+.engine-grid > .card.writer-card { flex: 2 1 400px; }
+.engine-grid > .card.wide { flex-basis: 100%; }
+.engine-grid > .card.compute-card { flex: 1.3 1 300px; }
+/* the Appearance card: two parts under a thin line, like the drawers */
+.appearance-card { container-type: inline-size; }
+.appearance-card .look-parts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 28px; }
+.appearance-card .look-part { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
+.appearance-card .look-part + .look-part { padding-left: 28px; border-left: 1px solid var(--line-soft); }
+/* a narrow card: the two parts stack, a thin line between them */
+@container (max-width: 700px) {
+  .appearance-card .look-parts { grid-template-columns: minmax(0, 1fr); }
+  .appearance-card .look-part + .look-part { padding: 12px 0 0; border-left: 0; border-top: 1px solid var(--line-soft); }
+}
+.appearance-card .mini { margin: 0; }
+.appearance-card .look-checks { display: flex; flex-direction: column; gap: 7px; }
+.appearance-card select option { font-size: 14px; }
+
+/* Appearance options, on <html> (the <head> script sets them before the first paint) */
+html[data-hover="accent"] {
+  --hover: color-mix(in srgb, var(--amber) 14%, transparent);
+  --hover-soft: color-mix(in srgb, var(--amber) 9%, transparent);
+  --hover-line: color-mix(in srgb, var(--amber) 55%, transparent);
+}
+html[data-corners="soft"] { --r-sm: 3px; --r-md: 5px; --r-lg: 8px; }
+html[data-corners="square"] { --r-sm: 1px; --r-md: 2px; --r-lg: 3px; }
+html[data-glow="on"] :is(.card, .drawer, .panel, .meta-card) {
+  box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 22%, transparent), 0 10px 30px -16px color-mix(in srgb, var(--amber) 50%, transparent);
+}
+html[data-motion="reduced"] *, html[data-motion="reduced"] *::before, html[data-motion="reduced"] *::after {
+  animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important;
+}
+.check-row { display: flex; align-items: center; gap: 2px; }
+.card.is-off .field, .card.is-off .check-row { opacity: .5; }
+.card-actions { margin-top: auto; display: flex; gap: 8px; justify-content: flex-end; }
+
+/* the workspace: form, run, library, all live at once */
+.workspace {
+  display: grid;
+  /* compose | run | takes -- the takes column widens with the screen instead of
+     staying pinned at a fixed width. Dragging a grip sets --col-left / --col-right. */
+  grid-template-columns:
+    var(--col-left, minmax(500px, 760px))
+    minmax(420px, 1fr)
+    var(--col-right, clamp(280px, 20vw, 560px));
+  gap: 1px;
+  background: var(--line);
+  height: calc(100vh - 52px - var(--playbar-h));
+  position: relative;
+}
+
+/* the grips on the lines between the columns: drag to resize, double-click for the default width.
+   Each is placed on its column's start line and straddles the 1px gap. */
+.col-grip {
+  position: absolute; grid-row: 1; top: 0; bottom: 0; left: -6px; width: 11px;
+  z-index: 7; cursor: col-resize; touch-action: none; outline: none;
+}
+.col-grip.left { grid-column: 2; }
+.col-grip.right { grid-column: 3; }
+.col-grip::after {
+  content: ""; position: absolute; top: 0; bottom: 0; left: 4px; width: 3px; border-radius: 2px;
+  background: transparent; transition: background .15s;
+}
+.col-grip:hover::after, .col-grip:focus-visible::after, .col-grip.is-dragging::after { background: var(--amber); }
+body.is-resizing, body.is-resizing * { cursor: col-resize !important; user-select: none !important; }
+
+.col { background: var(--ground); overflow-y: auto; padding: 18px 22px 60px; display: flex; flex-direction: column; gap: 16px; }
+.take-col { background: var(--take-bg); }
+/* Absolutely positioned bits inside a column (the hidden mode radios) must be
+   anchored to the column, or they stretch the page past the window and the
+   whole workspace scrolls up under the top bar. */
+.col, .library { position: relative; }
+
+.col-head {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  border-bottom: 1px solid var(--line);
+  position: sticky;
+  top: -18px;
+  z-index: 5;
+  margin: -18px -22px 0;
+  padding: 18px 22px 12px;
+  background: inherit;
+}
+.col-head h2 { margin: 0; font: 500 18px/1.4 var(--heading); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.take-col .col-head { flex-wrap: wrap; row-gap: 8px; }
+.col-note { white-space: nowrap; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
+
+.head-actions { display: flex; gap: 7px; flex: none; align-items: center; }
+
+/* ---------------------------------------------------------------- buttons */
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 8px 14px;
+  border-radius: var(--r-md);
+  border: 1px solid var(--line);
+  background: var(--raise);
+  color: var(--ink);
+  font-size: 13px;
+  cursor: pointer;
+  text-decoration: none;
+  transition: border-color .13s ease, background .13s ease, transform .08s ease;
+}
+.btn:hover { border-color: var(--hover-line, var(--dim)); background: var(--hover); }
+.btn:active { transform: translateY(1px); }
+.btn.ghost { background: transparent; color: var(--muted); }
+.btn.ghost:hover { color: var(--ink); }
+.btn.small { padding: 5px 10px; font-size: 12px; }
+.btn.danger:hover { color: var(--bad); border-color: var(--bad-line); }
+.btn.is-on { color: var(--amber); border-color: var(--amber-dim); }
+
+.btn.primary {
+  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
+  border-color: var(--amber-edge);
+  color: var(--on-amber);
+  font-weight: 600;
+}
+.btn.primary:hover { box-shadow: 0 0 0 3px color-mix(in srgb, var(--amber) 32%, transparent); }
+.btn[disabled] { opacity: .45; pointer-events: none; }
+.btn-glyph { font-size: 11px; }
+
+/* small drop-down menus (Save, library actions) */
+.menu-wrap { position: relative; flex: none; }
+.menu-pop {
+  position: absolute;
+  top: calc(100% + 6px);
+  left: 0;
+  z-index: 25;
+  min-width: 190px;
+  padding: 5px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  box-shadow: 0 14px 30px -12px var(--shadow-lg);
+}
+.menu-pop.right { left: auto; right: 0; }
+.menu-pop button {
+  padding: 7px 10px;
+  background: none;
+  border: 0;
+  border-radius: var(--r-sm);
+  color: var(--muted);
+  font-size: 12.5px;
+  text-align: left;
+  cursor: pointer;
+}
+.menu-pop button:hover, .menu-pop button:focus-visible { background: var(--hover); color: var(--ink); }
+.menu-pop [role="menuitemcheckbox"]::before { content: ""; display: inline-block; width: 1.2em; }
+.menu-pop [role="menuitemcheckbox"][aria-checked="true"]::before { content: "✓"; color: var(--amber); }
+.menu-pop button.danger:hover { color: var(--bad); }
+
+/* ------------------------------------------------------------------ forms */
+
+.compose { display: flex; flex-direction: column; gap: 16px; }
+.field { display: flex; flex-direction: column; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
+.field-row { display: flex; gap: 14px; align-items: flex-start; }
+.field-row.wrap { flex-wrap: wrap; row-gap: 12px; }
+.field-row.bottom { align-items: flex-end; }
+.grow { flex: 1; }
+.titlefield { min-width: 200px; }
+.seedfield { width: 212px; flex: none; }   /* room for a 19-digit seed */
+.row-hint { margin: -6px 0 0; font-size: 11.5px; color: var(--dim); max-width: 68ch; }
+
+.label {
+  font-size: 11px;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.label em { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--dim); margin-left: 8px; }
+
+input[type="text"], input[type="number"], textarea, select {
+  width: 100%;
+  padding: 9px 11px;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  color: var(--ink);
+  transition: border-color .13s ease, background .13s ease;
+}
+textarea { resize: vertical; line-height: 1.6; }
+textarea.mono { font-family: var(--mono); font-size: 12.5px; }
+input:hover, textarea:hover, select:hover { border-color: var(--hover-line, var(--line-strong)); }
+/* a little room between a number and its up/down arrows */
+input[type="number"]::-webkit-inner-spin-button { margin-left: 8px; }
+
+input[type="text"]:focus, input[type="number"]:focus, input[type="search"]:focus, textarea:focus, select:focus {
+  outline: 0; border-color: var(--amber); background: var(--focus-bg); }
+select:disabled { opacity: .7; }
+::placeholder { color: var(--placeholder); }
+
+#lyrics { font-family: var(--mono); font-size: 12.5px; }
+
+.seed-wrap { position: relative; }
+.seed-wrap input { padding-right: 38px; font-family: var(--mono); }
+
+.dice {
+  position: absolute;
+  right: 5px; top: 50%;
+  transform: translateY(-50%);
+  display: flex;
+  padding: 6px;
+  background: none;
+  border: 0;
+  border-radius: var(--r-sm);
+  color: var(--dim);
+  cursor: pointer;
+}
+.dice:hover { color: var(--amber); background: var(--hover-soft, var(--raise)); }
+
+/* modes: three switches on one plate */
+
+.modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
+.mode { cursor: pointer; }
+.mode input { position: absolute; opacity: 0; pointer-events: none; }
+
+.mode-body {
+  display: block;
+  height: 100%;
+  padding: 11px 12px;
+  background: var(--field);
+  border: 1px solid var(--line);
+  border-top: 2px solid var(--line);
+  border-radius: var(--r-md);
+  transition: border-color .13s ease, background .13s ease;
+}
+.mode-body strong { display: block; font-size: 13px; font-weight: 600; margin-bottom: 3px; }
+.mode-body small { display: block; font-size: 11px; line-height: 1.45; color: var(--dim); }
+.mode:hover .mode-body { border-color: var(--hover-line, var(--line-strong)); }
+
+.mode input:checked + .mode-body {
+  background: var(--raise);
+  border-color: var(--line);
+  border-top-color: var(--amber);
+}
+.mode input:checked + .mode-body strong { color: var(--amber); }
+.mode input:checked + .mode-body small { color: var(--muted); }
+.mode input:focus-visible + .mode-body { outline: 2px solid var(--amber); outline-offset: 2px; }
+
+/* drawers */
+
+.drawer { border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel); }
+
+/* a drawer's heading: its name, and under it one sentence (or its live summary) that wraps under the
+   name in a narrow column, never beside it */
+.drawer > summary {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 12px 14px;
+  cursor: pointer;
+  list-style: none;
+  color: var(--ink);
+}
+.drawer > summary::-webkit-details-marker { display: none; }
+.drawer > summary .chev { flex: none; margin-top: 6px; }
+.sum-head { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.sum-name { font-size: 13.5px; font-weight: 500; }
+.sum-say { font-size: 12px; line-height: 1.45; color: var(--dim); }
+
+.chev {
+  width: 0; height: 0;
+  border-left: 5px solid var(--muted);
+  border-top: 4px solid transparent;
+  border-bottom: 4px solid transparent;
+  transition: transform .16s ease;
+}
+.drawer[open] > summary .chev { transform: rotate(90deg); }
+.drawer[open] > summary { border-bottom: 1px solid var(--line-soft); }
+
+.drawer-body { padding: 15px 13px; display: flex; flex-direction: column; gap: 13px; }
+.hint { margin: 0; font-size: 12px; color: var(--dim); max-width: 62ch; }
+
+.chiprow { display: flex; flex-wrap: wrap; gap: 7px; }
+
+.chip {
+  padding: 5px 10px;
+  background: var(--raise);
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  color: var(--muted);
+  font-size: 12px;
+  cursor: pointer;
+}
+.chip:hover { color: var(--ink); border-color: var(--patina-dim); }
+
+/* sampling knobs */
+
+.sampler-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
+.sampler h4 { margin: 0 0 10px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 7px; }
+.dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
+.dot.amber { background: var(--amber); }
+.dot.patina { background: var(--patina); }
+
+.knobs { display: grid; gap: 9px; }
+.knob { display: grid; grid-template-columns: 1fr 84px; gap: 9px; align-items: center; }
+.knob span { font-size: 12px; color: var(--dim); }
+.knob input { padding: 5px 8px; font-family: var(--mono); font-size: 12px; text-align: right; }
+.reset-cell { justify-content: flex-end; align-items: flex-start; padding-top: 22px; }
+/* Cover or remix: two parts of the same shape, a thin line between them */
+.cover-body { gap: 16px; }
+.cover-part { display: flex; flex-direction: column; gap: 11px; }
+.cover-part + .cover-part { padding-top: 16px; border-top: 1px solid var(--line-soft); }
+.cover-part .mini { margin: 0; }
+.mini em { font-style: normal; text-transform: none; letter-spacing: 0; font-size: 11.5px; color: var(--dim); margin-left: 8px; }
+.cover-act { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
+.cover-act .btn, .drawer-act .btn { flex: none; width: 172px; height: 30px; justify-content: center; padding: 0 12px; font-size: 12.5px; }
+.cover-status { flex: 1 1 200px; margin: 0; font-size: 11.5px; color: var(--dim); }
+.cover-status:empty { display: none; }
+/* a drawer's action buttons: under a thin line, on the left, all one size */
+.drawer-act { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-top: 13px; border-top: 1px solid var(--line-soft); }
+
+
+.check { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: var(--muted); cursor: pointer; }
+.check input { width: auto; accent-color: var(--amber); }
+.small-check { font-size: 12px; }
+
+/* sound and output: the C++ engine's own knobs */
+.out-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 14px; }
+.out-grid input, .out-grid select { font-family: var(--mono); font-size: 12.5px; }
+
+/* reused music codes: say plainly what Generate will do */
+.codes-note {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 12px;
+  background: color-mix(in srgb, var(--amber) 7%, var(--panel));
+  border: 1px solid var(--amber-dim);
+  border-radius: var(--r-md);
+  font-size: 12.5px;
+  color: var(--muted);
+}
+.codes-note > div { flex: 1; min-width: 0; }
+.codes-note strong { display: block; color: var(--amber); font-weight: 600; font-size: 12.5px; }
+
+/* submit */
+
+.submit-bar {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px 16px;
+  padding: 14px 0 0;
+  border-top: 1px solid var(--line);
+}
+.submit-actions { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 10px 12px; }
+.submit-actions .btn { height: 32px; min-width: 156px; padding: 0 16px; justify-content: center; font-size: 13px; }
+.submit-note { order: 3; flex-basis: 100%; margin: 0; font-size: 12px; color: var(--dim); }
+.submit-note:empty { display: none; }
+
+/* ------------------------------------------------------------------- muse */
+/* The writer belongs to the symbolic side of the room, so it takes the patina
+   accent and leaves amber to the transport. */
+
+.muse {
+  margin-bottom: 20px;
+  padding: 15px 16px;
+  background: linear-gradient(180deg, color-mix(in srgb, var(--patina) 5%, transparent), transparent 70%), var(--panel);
+  border: 1px solid var(--line);
+  border-left: 2px solid var(--patina-dim);
+  border-radius: var(--r-lg);
+  display: flex;
+  flex-direction: column;
+  gap: 11px;
+}
+
+/* the idea: a full line that grows with its text, like the style box */
+#idea { field-sizing: content; min-height: calc(2lh + 20px); max-height: 40vh; resize: vertical; }   /* two lines to start */
+/* the writer model is shown, not picked: the page never switches the chat server's model */
+.static-field { display: flex; align-items: baseline; gap: 8px; min-height: 42px; box-sizing: border-box; padding: 11px 13px;
+  border: 1px dashed var(--line); border-radius: var(--r-md); font-size: 13px; color: var(--ink); min-width: 0; }
+.static-field .dim { color: var(--dim); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+
+.btn.writer {
+  flex: none;
+  border-color: var(--patina-dim);
+  color: var(--patina);
+  background: color-mix(in srgb, var(--patina) 7%, transparent);
+}
+.btn.writer:hover { background: color-mix(in srgb, var(--patina) 14%, transparent); border-color: var(--patina); }
+.btn.writer[data-busy="1"] { pointer-events: none; opacity: .8; }
+.btn.writer[data-busy="1"] #museGlyph { display: inline-block; animation: spin 1.1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* one footer under a thin line: the two buttons first, the same size, then the checkbox */
+.muse-foot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-top: 13px; border-top: 1px solid var(--line-soft); }
+.muse-foot .check { margin-left: 6px; }
+.muse-status { margin: -4px 0 0; font-size: 11px; color: var(--patina); }
+.muse-status:empty { display: none; }
+.muse-status.bad { color: var(--bad); }
+/* the chat server's state: a square button, green when it answers, red when not. Both labels share one
+   grid cell, so it is always as wide as the longer one and never changes size; the details are its tip. */
+.chat-link { display: inline-grid; flex: none; align-items: center; justify-items: center; height: 28px; padding: 0 12px;
+  border: 1px solid var(--bad-line); border-radius: 2px; background: color-mix(in srgb, var(--bad) 12%, transparent);
+  color: var(--bad); font: 600 12px/1 var(--sans); white-space: nowrap; cursor: pointer; }
+.chat-link > span { grid-area: 1 / 1; }
+.chat-link[data-s="on"] { border-color: var(--good-line); background: color-mix(in srgb, var(--good) 12%, transparent); color: var(--good); }
+.chat-link[data-s="on"] .off, .chat-link[data-s="off"] .on { visibility: hidden; }
+.chat-link:hover { filter: brightness(1.15); }
+/* Write the brief beside it, the same size */
+.muse-foot .chat-link, .muse-foot .btn.writer { width: 172px; height: 30px; }
+.muse-foot .btn.writer { justify-content: center; padding: 0 12px; font-size: 12.5px; }
+.muse-foot .btn.writer:disabled { opacity: .45; cursor: default; }
+
+/* The writer lives in a closed drawer; inside it the muse panel drops its own frame. */
+#museDrawer .muse { margin: 0; padding: 0; background: none; border: 0; border-radius: 0; }
+.col .col-head + .drawer { margin-top: 2px; }
+
+/* -------------------------------------------------------------- run chain */
+
+.chain {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r-lg);
+  padding: 16px 18px;
+  margin-bottom: 22px;
+}
+
+.chain-head { display: flex; align-items: center; gap: 13px; margin-bottom: 15px; min-width: 0; }
+.run-what { font-size: 12px; color: var(--dim); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.run-state {
+  font-size: 10.5px;
+  letter-spacing: .16em;
+  text-transform: uppercase;
+  padding: 4px 9px;
+  border-radius: 20px;
+  border: 1px solid var(--line);
+  color: var(--muted);
+  flex: none;
+}
+.run-state[data-s="running"] { color: var(--amber); border-color: var(--amber-dim); }
+.run-state[data-s="done"] { color: var(--good); border-color: var(--good-line); }
+.run-state[data-s="failed"] { color: var(--bad); border-color: var(--bad-line); }
+.run-state[data-s="cancelled"] { color: var(--dim); }
+
+.run-clock { font-size: 15px; color: var(--ink); flex: none; }
+.run-seeds { margin: -6px 0 10px; font-size: 11px; color: var(--dim); overflow-wrap: anywhere; }
+.run-seeds:empty { display: none; }
+
+.stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
+
+.stage {
+  display: grid;
+  grid-template-columns: 20px 1fr auto;
+  gap: 12px;
+  align-items: center;
+  padding: 9px 4px;
+  border-radius: var(--r-sm);
+}
+.stage + .stage { border-top: 1px solid var(--line-soft); }
+
+.stage-num {
+  font: 500 10px/1 var(--mono);
+  color: var(--dim);
+  text-align: center;
+}
+
+.stage-main { min-width: 0; }
+.stage-label { font-size: 13px; display: flex; align-items: center; gap: 8px; }
+.stage-note { font-size: 11px; color: var(--dim); }
+
+.meter {
+  height: 3px;
+  margin-top: 7px;
+  background: var(--sunk);
+  border-radius: 2px;
+  overflow: hidden;
+}
+.meter i {
+  display: block;
+  height: 100%;
+  width: 100%;
+  transform: scaleX(0);
+  transform-origin: left;
+  background: var(--amber);
+  transition: transform .25s ease;
+}
+.meter.indeterminate i {
+  width: 34%;
+  background: linear-gradient(90deg, transparent, var(--amber), transparent);
+  animation: slide 1.35s linear infinite;
+}
+@keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
+
+.stage-read { font-family: var(--mono); font-size: 11.5px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.stage-read b { color: var(--ink); font-weight: 500; }
+
+.stage[data-s="waiting"] { opacity: .42; }
+.stage[data-s="running"] .stage-label { color: var(--amber); }
+.stage[data-s="completed"] .stage-num { color: var(--good); }
+.stage[data-s="failed"] .stage-label { color: var(--bad); }
+.stage[data-s="skipped"] { opacity: .3; }
+
+.run-error {
+  margin: 14px 0 0;
