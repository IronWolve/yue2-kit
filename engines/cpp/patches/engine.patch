+}
+
+/* DMM: zinc-950 grounds, electric purple, cyan and neon green, with its own fonts (Michroma headings,
+   Space Grotesk text; a browser fetches them only while this theme shows them). The purple text is lifted
+   from the brand #bf00ff (3.8:1 on the raised panels) to clear 4.5:1; its play button keeps the brand
+   purple through --accent-rgb. */
+[data-theme="dmm"] {
+  --ground: #09090b;
+  --panel: #111114;
+  --raise: #1a1a1f;
+  --sunk: #060608;
+  --line: #27272a;
+  --line-soft: #1e1e22;
+  --line-strong: #3f3f46;
+  --ink: #e4e4e7;
+  --muted: #b4b4bc;
+  --dim: #a1a1aa;
+  --placeholder: #8b8b95;
+  --amber: #c94bff;
+  --amber-dim: #6b21a8;
+  --amber-hi: #d470ff;
+  --amber-hi2: #de8cff;
+  --amber-edge: #9a00cc;
+  --on-amber: #0a0012;
+  --patina: #00f0ff;
+  --patina-dim: #0b5c63;
+  --good: #39ff14;
+  --good-line: #1f5e14;
+  --bad: #ff5c6c;
+  --bad-line: #6b1f28;
+  --bad-ink: #ff9aa4;
+  --take-bg: #0c0c0f;
+  --hover: #1f1f24;
+  --focus-bg: #0f0f12;
+  --field: #060608;
+  --accent-rgb: 191 0 255;
+  --hover: rgb(191 0 255 / .14);        /* hover highlights in the theme's purple, not grey */
+  --hover-soft: rgb(191 0 255 / .09);
+  --hover-line: rgb(191 0 255 / .55);
+  --sans: "Space Grotesk", "Segoe UI", system-ui, sans-serif;
+  --heading: "Michroma", "Segoe UI", system-ui, sans-serif;
+  --display: "Michroma", "Segoe UI", system-ui, sans-serif;
+  --shadow-md: rgba(0, 0, 0, .5);
+  --shadow-lg: rgba(0, 0, 0, .9);
+  color-scheme: dark;
+}
