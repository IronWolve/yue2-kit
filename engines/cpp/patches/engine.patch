+      paintSubmitNote();
+      toastOnce("offline", "Could not reach the server: " + error.message, "bad");
+      setTimeout(boot, 5000);
+    });
+  }
+
+  buildKnobs();
+  syncShape();
+  paintOutputDefaults();
+  paintSliders();
+  paintLibrary();
+  paintEngine();
+  boot();
+})();
