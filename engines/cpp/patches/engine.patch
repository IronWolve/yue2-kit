+#include "request.h"
+#include <cstdio>
+int main() {
+    const char * json = R"({"title":"Keep my layout","style":"piano","lyrics":"Test","vae":"blend","sliders":[{"id":"female","strength":0.25}],"loras":[{"id":"sv-industrial/style.safetensors","ar":0.7,"nar":0.3}],"adapters":[{"name":"extra.safetensors","scale":0.5}],"source_tokens":"1,2,3","source_start":0.04,"source_end":0.12,"parent":"prior","plan_only":false,"seed":123,"lm_seed":456})";
+    Yue2Request a,b;
+    request_init(&a); request_init(&b);
+    if (!request_parse_json(&a,json) || !request_parse_json(&b,request_to_json(&a,false).c_str())) return 1;
+    if (b.title!=a.title || b.vae!="blend" || b.parent!="prior" || b.sliders.size()!=1 || b.loras.size()!=1 ||
+        b.loras[0].id!=a.loras[0].id || b.loras[0].ar!=a.loras[0].ar || b.loras[0].nar!=a.loras[0].nar ||
+        b.adapters.size()!=1 || b.adapters[0].name!=a.adapters[0].name || b.adapters[0].scale!=0.5f ||
+        b.source_tokens!="1,2,3" || b.source_start!=a.source_start || b.source_end!=a.source_end || b.plan_only) return 1;
+    auto replay=request_replay(b,"score","4,5,6",0,0);
+    if (!replay.source_tokens.empty() || replay.source_start!=0 || replay.source_end!=-1 || replay.semantic_tokens!="4,5,6" ||
+        replay.loras.size()!=1 || replay.vae!="blend" || replay.title!=a.title) return 1;
+    puts("PASS local settings, sliders, LoRAs, upstream adapters and continuation round-trip; replay clears continuation");
+}
