+     badge(kind)                 the small STOCK / ADD-ON mark, for the form too */
+(function (root) {
+  "use strict";
+
+  var NOTES = { standard: "best sound", legacy: "benchmark", blend: "⅔ standard, ⅓ legacy" };
+  var PUBLISHER = "m-a-p/";   // the model's own releases; anything else is an add-on
+  var KIND_TIPS = {
