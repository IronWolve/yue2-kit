From 24c34472a39566f922f653a196b3a7ac73ea204e Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Mon, 28 Sep 2026 12:00:23 -0700
Subject: [PATCH 58/58] The music note top left opens the collection's
 repository; About's projects in two columns

The music-note logo in the top-left corner links the collection's own repository, in a new tab, and lifts on hover. The status beside it (Ready, Generating...) is plain text again. In About, YuE2 stands in the left column and the engine, the layout and the tensor library are stacked in the right one.
---
 tools/console/app.css    | 11 ++++++-----
 tools/console/index.html | 14 +++++++-------
 2 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index abfe763..ae73c17 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -429,7 +429,8 @@ button, input, select, textarea { font: inherit; color: inherit; }
 }
 
 .brand { display: flex; align-items: center; gap: 9px; flex: none; }
-.brand-mark { color: var(--amber); display: flex; }
+.brand-mark { color: var(--amber); display: flex; text-decoration: none; border-radius: var(--r-sm, 4px); transition: color .12s ease, transform .12s ease; }
+.brand-mark:hover, .brand-mark:focus-visible { color: var(--ink); transform: translateY(-1px); }   /* the collection's repo */
 .brand h1 { margin: 0; font: 400 21px/1 var(--display); letter-spacing: .01em; }
 .brand h1 .two { color: var(--amber); }
 .brand-link { color: inherit; text-decoration: none; }   /* the model's repo */
@@ -446,12 +447,14 @@ button, input, select, textarea { font: inherit; color: inherit; }
 /* two bands: the three projects (the model, the engine, the tensor library), then the add-ons */
 .about-grid { display: flex; flex-direction: column; gap: 16px; container-type: inline-size; }
 .about-projects, .about-addons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; }
-.about-projects { grid-template-columns: minmax(0, 1fr); gap: 14px; }   /* the four projects in one column */
+/* two columns: the model on the left, the engine, the layout and the tensor library stacked on the right */
+.about-projects { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 28px; }
+.about-projects > .about-project:first-child { grid-row: span 3; }
 .about-addons { padding-top: 14px; border-top: 1px solid var(--line-soft); }
 .about-project h4 { margin: 0; font: 500 15px/1.2 var(--heading); color: var(--ink); letter-spacing: 0; text-transform: none; }
 .about-what { margin: 2px 0 9px; color: var(--muted); font-size: 12px; }
 .about-addons h4 { margin: 0 0 7px; font: 600 10px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
-@container (max-width: 760px) { .about-projects, .about-addons { grid-template-columns: minmax(0, 1fr); } }
+@container (max-width: 760px) { .about-projects, .about-addons { grid-template-columns: minmax(0, 1fr); } .about-projects > .about-project:first-child { grid-row: auto; } }
 .about-links { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
 .about-links li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; min-width: 0; }
 .about-links a, .about-links .about-name { color: var(--ink); font-size: 13.5px; font-weight: 500; text-decoration: none; }
@@ -486,8 +489,6 @@ button, input, select, textarea { font: inherit; color: inherit; }
 
 /* the GPU readout: two small lines (GPU, VRAM) that fit a small screen; its tip has the rest */
 .hw-strip { display: grid; gap: 1px; margin: 0; font-size: 10.5px; line-height: 1.3; min-width: 0; flex: none; cursor: default; }
-a.engine-chip { color: inherit; text-decoration: none; }
-a.engine-chip:hover small, a.engine-chip:focus-visible small { text-decoration: underline; text-underline-offset: 2px; }
 .head-actions .hw-strip { margin-right: 6px; }
 .hw-strip div { display: flex; gap: 6px; align-items: baseline; white-space: nowrap; }
 .hw-strip dt { color: var(--dim); min-width: 32px; }
diff --git a/tools/console/index.html b/tools/console/index.html
index 4e7c648..98d9c4b 100644
--- a/tools/console/index.html
+++ b/tools/console/index.html
@@ -21,27 +21,27 @@
 <!-- ---------------------------------------------------------------- topbar -->
 <header class="topbar">
   <div class="brand">
-    <div class="brand-mark" aria-hidden="true">
-      <svg viewBox="0 0 40 40" width="26" height="26">
+    <!-- the music note, top left: it opens the collection's own repository -->
+    <a class="brand-mark" href="https://github.com/IronWolve/yue2-kit" target="_blank" rel="noopener noreferrer" aria-label="yue2-kit on GitHub"
+       data-tip="yue2-kit on GitHub: this collection's install kit, its patches and its releases">
+      <svg viewBox="0 0 40 40" width="26" height="26" aria-hidden="true">
         <path d="M6 30 L6 12 L20 8 L20 26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
         <circle cx="10.5" cy="30" r="4.4" fill="currentColor"/>
         <circle cx="24.5" cy="26" r="4.4" fill="currentColor"/>
         <path d="M28 13 L36 13 M28 18 L36 18 M28 23 L36 23" stroke="currentColor" stroke-width="1.1" opacity="0.55"/>
       </svg>
-    </div>
+    </a>
     <h1><a class="brand-link" href="https://github.com/multimodal-art-projection/YuE" target="_blank" rel="noopener noreferrer" data-tip="YuE, the music model this app runs: its repo on GitHub (opens in a new tab)">YuE<span class="two">2</span></a></h1>
     <a class="engine-tag" href="https://github.com/ServeurpersoCom/yue2.cpp" target="_blank" rel="noopener noreferrer" data-tip="The C++ engine this page runs on: its repo on GitHub (opens in a new tab)">cpp</a>
   </div>
 
