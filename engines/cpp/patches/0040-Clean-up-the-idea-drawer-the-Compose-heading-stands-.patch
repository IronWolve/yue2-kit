From 2a02283a9fff0706f1a373e4e2024164dc608246 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:41:06 -0700
Subject: [PATCH 40/49] Clean up the idea drawer; the Compose heading stands
 alone

The drawer gets labels like the rest of the form (Idea, Structure, Writer model, each (i) on its label), the writer model as a read-only box instead of a disabled menu, and the structure's note inside its (i). The small chat server tag goes: the Chat Server button already says it. Under a thin line, the Chat Server button and Write the brief sit together on the left at the same size, then the checkbox; a run's result line goes under them. The Compose heading loses its tagline.
---
 tools/console/app.css    | 40 +++++++++++++---------------------------
 tools/console/app.js     | 12 +++++++++---
 tools/console/help.js    |  1 -
 tools/console/index.html | 27 +++++++++++----------------
 4 files changed, 33 insertions(+), 47 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index 0b27fda..c5f48cd 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -820,26 +820,12 @@ select:disabled { opacity: .7; }
   gap: 11px;
 }
 
-.muse-head { display: flex; align-items: center; gap: 10px; }
-
-.muse-tag {
-  font-size: 9.5px;
-  letter-spacing: .14em;
-  text-transform: uppercase;
-  color: var(--patina);
-  border: 1px solid var(--patina-dim);
-  border-radius: 20px;
-  padding: 2px 8px;
-}
-
-#museModel { width: auto; max-width: 260px; padding: 5px 9px; font-size: 12px; }
-
-.muse-row { display: flex; gap: 10px; align-items: flex-end; }
-.muse-row.secondary { max-width: 420px; }
-.muse-row.secondary select { padding: 6px 9px; font-size: 12.5px; }
-.muse-row input { flex: 1; }
 /* the idea: a full line that grows with its text, like the style box */
-#idea { flex: 1; field-sizing: content; min-height: 0; max-height: 40vh; resize: vertical; }
+#idea { field-sizing: content; min-height: 0; max-height: 40vh; resize: vertical; }
+/* the writer model is shown, not picked: the page never switches the chat server's model */
+.static-field { display: flex; align-items: baseline; gap: 8px; min-height: 42px; box-sizing: border-box; padding: 11px 13px;
+  border: 1px dashed var(--line); border-radius: var(--r-md); font-size: 13px; color: var(--ink); min-width: 0; }
+.static-field .dim { color: var(--dim); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 
 .btn.writer {
   flex: none;
@@ -852,12 +838,10 @@ select:disabled { opacity: .7; }
 .btn.writer[data-busy="1"] #museGlyph { display: inline-block; animation: spin 1.1s linear infinite; }
 @keyframes spin { to { transform: rotate(360deg); } }
 
-.muse-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
-.muse-foot .check { font-size: 11.5px; color: var(--dim); }
-.muse .row-hint { margin: 0; }
-/* the two buttons stay together on the right; the status line (a run's result) goes under them */
-.muse-actions { display: flex; flex: none; gap: 8px; align-items: center; margin-left: auto; }
-.muse-status { order: 3; flex-basis: 100%; text-align: right; font-size: 11px; color: var(--patina); }
+/* one footer under a thin line: the two buttons first, the same size, then the checkbox */
+.muse-foot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-top: 13px; border-top: 1px solid var(--line-soft); }
+.muse-foot .check { margin-left: 6px; }
+.muse-status { margin: -4px 0 0; font-size: 11px; color: var(--patina); }
 .muse-status:empty { display: none; }
 .muse-status.bad { color: var(--bad); }
 /* the chat server's state: a square button, green when it answers, red when not. Both labels share one
@@ -869,8 +853,10 @@ select:disabled { opacity: .7; }
 .chat-link[data-s="on"] { border-color: var(--good-line); background: color-mix(in srgb, var(--good) 12%, transparent); color: var(--good); }
 .chat-link[data-s="on"] .off, .chat-link[data-s="off"] .on { visibility: hidden; }
 .chat-link:hover { filter: brightness(1.15); }
-/* Write the brief sits beside it, the same height */
-.muse-foot .btn.writer { height: 28px; padding: 0 12px; font-size: 12px; }
+/* Write the brief beside it, the same size */
+.muse-foot .chat-link, .muse-foot .btn.writer { width: 172px; height: 30px; box-sizing: border-box; }
+.muse-foot .btn.writer { justify-content: center; padding: 0 12px; font-size: 12.5px; }
+.muse-foot .btn.writer:disabled { opacity: .45; cursor: default; }
 
 /* The writer lives in a closed drawer; inside it the muse panel drops its own frame. */
 #museDrawer .muse { margin: 0; padding: 0; background: none; border: 0; border-radius: 0; }
