 .prompt-text:empty { display: none; }
 
-/* the song's details: one card, a section label on the left, labels and values in fixed columns */
+/* the song's details: one compact card. Song | Sound | Shape, then Sliders | LoRAs, then the seeds */
 .meta-card { border: 1px solid var(--line); border-radius: 10px; background: var(--panel); container-type: inline-size; }
-.meta-sec { display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 0 14px; padding: 11px 16px; border-top: 1px solid var(--line-soft); }
-.meta-sec:first-child { border-top: none; }
-.meta-sec h4 { margin: 2px 0 0; font: 600 10.5px/1.6 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
-.meta-kv { display: grid; gap: 5px 12px; align-items: baseline; margin: 0; min-width: 0; }
-.meta-kv > div { display: contents; }
-.mkv2 { grid-template-columns: 104px minmax(0, 1fr) 84px minmax(0, 1fr); }
-.mkv1 { grid-template-columns: 104px minmax(0, 1fr); }
-.mkv3 { grid-template-columns: 104px minmax(0, 11em) minmax(0, 1fr); }
-.meta-kv dt { color: var(--muted); font-size: 12.5px; }
-.meta-kv dd { margin: 0; min-width: 0; color: var(--ink); font-size: 13.5px; font-weight: 500; overflow-wrap: anywhere; }
-.meta-kv dd.num, .meta-kv .num { font-family: var(--mono); font-size: 12.5px; }
-.meta-kv dd.warn { color: var(--amber); }
-.kv-note { margin-left: 4px; color: var(--muted); font-family: var(--mono); font-size: 11.5px; font-weight: 400; }
-.dots { display: inline-flex; gap: 5px; margin-right: 10px; vertical-align: 0; }
-.dots i { width: 9px; height: 9px; border: 1px solid var(--amber-dim); border-radius: 50%; }
+.meta-row { display: grid; padding: 10px 0; border-top: 1px solid var(--line-soft); }
+.meta-row:first-child { border-top: none; }
+.meta-row.trio { grid-template-columns: auto auto minmax(0, 1fr); }
+.meta-row.duo { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
+.meta-row.seeds { padding: 10px 14px; }
+.meta-col { min-width: 0; padding: 0 14px; border-left: 1px solid var(--line-soft); }
+.meta-col:first-child { border-left: none; }
+.meta-col h4 { margin: 0 0 6px; font: 600 10px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
+.meta-rows { display: grid; grid-template-columns: auto auto; justify-content: start; align-items: baseline; gap: 5px 8px; margin: 0; }
+.meta-rows > div { display: contents; }
+.meta-rows dt { color: var(--muted); font-size: 12.5px; }
+.meta-rows dd { margin: 0; min-width: 0; color: var(--ink); font-size: 13.5px; font-weight: 500; white-space: nowrap; }
+.meta-rows dd.num { font-family: var(--mono); font-size: 12.5px; }
+.meta-rows dd.warn { color: var(--amber); }
+.meta-rows.addons { gap: 5px 12px; }
+.meta-rows.addons .name { color: var(--ink); font-size: 13.5px; font-weight: 500; overflow-wrap: anywhere; }
+.meta-rows.addons .amt { color: var(--muted); font: 12px/1.35 var(--mono); white-space: nowrap; }
+.meta-rows.addons .none { color: var(--dim); font-size: 12.5px; }
+.meta-rows.seeds { grid-template-columns: auto auto auto; gap: 4px 10px; }
+.dots { display: inline-flex; gap: 4px; margin-right: 8px; }
+.dots i { width: 8px; height: 8px; border: 1px solid var(--amber-dim); border-radius: 50%; }
 .dots i.on { background: var(--amber); border-color: var(--amber); }
 .dots.custom i { border-style: dashed; }
-.meta-card .bar { position: relative; display: inline-block; width: 64px; height: 4px; margin-right: 8px; overflow: hidden;
+.meta-card .bar { position: relative; display: inline-block; width: 36px; height: 3px; margin-right: 6px; overflow: hidden;
   border-radius: 2px; background: var(--line-soft); vertical-align: middle; }
 .meta-card .bar b { position: absolute; inset: 0 auto 0 0; background: var(--amber); }
-.seed-copy { margin-left: 8px; padding: 1px 6px; border: 1px solid var(--line-soft); border-radius: 5px; background: transparent;
-  color: var(--dim); font: 11px/1.4 var(--sans); cursor: pointer; }
-.seed-copy:hover { color: var(--ink); border-color: var(--line); }
-@container (max-width: 560px) {
-  .meta-sec { grid-template-columns: minmax(0, 1fr); gap: 6px; }
-  .mkv2 { grid-template-columns: 96px minmax(0, 1fr); }
-  .mkv3 { grid-template-columns: 96px minmax(0, 1fr) auto; }
+.seed-copy { padding: 0 4px; border: none; background: transparent; color: var(--dim); font-size: 13px; line-height: 1; cursor: pointer; }
+.seed-copy:hover { color: var(--ink); }
+/* narrower than this card was designed for: Shape drops under Song | Sound, then Sliders over LoRAs */
+@container (max-width: 500px) {
+  .meta-row.trio { grid-template-columns: auto minmax(0, 1fr); row-gap: 10px; }
+  .meta-row.trio > .meta-col:last-child { grid-column: 1 / -1; padding-top: 10px; border-left: none; border-top: 1px solid var(--line-soft); }
 }
+@container (max-width: 380px) {
+  .meta-row.duo { grid-template-columns: minmax(0, 1fr); row-gap: 10px; }
+  .meta-row.duo > .meta-col + .meta-col { border-left: none; }
+}
