From 9956f5b455f4eadeaba40556fb346bfe2ce20a77 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Mon, 28 Sep 2026 11:32:57 -0700
Subject: [PATCH 55/57] Takes beside the buttons; Writer and Appearance on rows
 of their own

The bottom bar's Takes box joins the two buttons as one group on the right (it wraps above them, still right-aligned, in a narrow column). On the Engine page the Writer card takes a row of its own, and so does Appearance, with its Theme and Fonts parts side by side (stacked when the card is narrow).
---
 tools/console/app.css    | 13 ++++++++++---
 tools/console/index.html | 12 +++++++-----
 2 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index cac41dc..f4dfc14 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -521,8 +521,15 @@ body:has(#view-engine:not(.is-hidden)) #engineToggle { background: var(--amber);
 .engine-grid > .card.wide { flex-basis: 100%; }
 .engine-grid > .card.compute-card { flex: 1.3 1 300px; }
 /* the Appearance card: two parts under a thin line, like the drawers */
-.appearance-card .look-part { display: flex; flex-direction: column; gap: 10px; }
-.appearance-card .look-part + .look-part { padding-top: 12px; border-top: 1px solid var(--line-soft); }
+.appearance-card { container-type: inline-size; }
+.appearance-card .look-parts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 28px; }
+.appearance-card .look-part { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
+.appearance-card .look-part + .look-part { padding-left: 28px; border-left: 1px solid var(--line-soft); }
+/* a narrow card: the two parts stack, a thin line between them */
+@container (max-width: 700px) {
+  .appearance-card .look-parts { grid-template-columns: minmax(0, 1fr); }
+  .appearance-card .look-part + .look-part { padding: 12px 0 0; border-left: 0; border-top: 1px solid var(--line-soft); }
+}
 .appearance-card .mini { margin: 0; }
 .appearance-card .look-checks { display: flex; flex-direction: column; gap: 7px; }
 .appearance-card select option { font-size: 14px; }
@@ -859,7 +866,7 @@ select:disabled { opacity: .7; }
   padding: 14px 0 0;
   border-top: 1px solid var(--line);
 }
-.submit-actions { margin-left: auto; display: flex; gap: 10px; }
+.submit-actions { margin-left: auto; display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 10px 12px; }
 .submit-actions .btn { height: 32px; min-width: 156px; padding: 0 16px; justify-content: center; font-size: 13px; }
 .submit-note { order: 3; flex-basis: 100%; margin: 0; font-size: 12px; color: var(--dim); }
 .submit-note:empty { display: none; }
