From a1730ada83bcd76363628d4e2be662179ce52802 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Sat, 26 Sep 2026 12:31:45 -0700
Subject: [PATCH 24/45] Step the temperature knobs by 0.01

The presets and the useful range sit on hundredths (0.55, 0.85, 0.9-0.95); the arrows moved by 0.1.
---
 tools/console/app.js | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tools/console/app.js b/tools/console/app.js
index 4fd8d44..0a02947 100644
--- a/tools/console/app.js
+++ b/tools/console/app.js
@@ -317,12 +317,13 @@
 
   /* ------------------------------------------------------------ sampling */
 
-  // Decimal knobs step in their own scale: temperature 0.7 -> 0.8, not 0.7 -> 1.
+  // Decimal knobs step in their own scale: temperature 0.70 -> 0.71 (the presets
+  // and the useful range, 0.9-0.95, sit on hundredths), not 0.7 -> 1.
   // Repetition penalty sits near 1.0 in the planner (1.005) and higher for music
   // tokens (1.2), so its step follows the default. Anything else uses the step
   // column of SAMPLER_KNOBS (top-k 1, window 1, max tokens 100).
   function knobStep(knob, def) {
-    if (knob[0] === "temperature") return 0.1;
+    if (knob[0] === "temperature") return 0.01;
     if (knob[0] === "top_p") return 0.05;
     if (knob[0] === "repetition_penalty") return def < 1.05 ? 0.005 : 0.05;
     return knob[2] || 1;
