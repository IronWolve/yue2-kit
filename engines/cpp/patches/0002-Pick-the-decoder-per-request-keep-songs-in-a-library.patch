+    }
+    yyjson_mut_val * e = yyjson_val_mut_copy(out, yyjson_doc_get_root(meta));
+    yyjson_doc_free(meta);
+    yyjson_mut_obj_remove_key(e, "name");
+    yyjson_mut_obj_add_strcpy(out, e, "name", name.c_str());
+    Yue2Request r;
