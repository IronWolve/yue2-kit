+  // F32 beside the model menu: one press for full-precision maths, again for BF16 (loads with the next song)
+  function paintF32(settings) {
+    var on = !!settings && settings.precision === "f32";
+    $("f32Toggle").setAttribute("aria-pressed", String(on));
+  }
+  $("f32Toggle").addEventListener("click", function () {
+    var want = this.getAttribute("aria-pressed") === "true" ? "bf16" : "f32";
+    post("/settings", { precision: want }).then(function (data) {
+      paintSettings(data, true);
+      toast(want === "f32" ? "F32 on: the next song loads full-precision weights (about twice the memory, slower)"
+                           : "BF16: the next song loads the release weights", "good");
+    }).catch(function (error) { toast(error.message, "bad"); });
+  });
+
   function paintSettings(settings, force) {
     STATE.settings = settings;
     paintModelPick(settings);
+    paintF32(settings);
     // A background refresh must not wipe fields you are still editing; Save repaints them.
     if (STATE.settingsDirty && !force) {
       paintStrip();
