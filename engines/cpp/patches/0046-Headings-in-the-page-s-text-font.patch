From 3fa48cca5cc273961238f119915d5fe374b857c3 Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Sun, 27 Sep 2026 19:28:51 -0700
Subject: [PATCH 46/52] Headings in the page's text font

Column, card, panel, Engine and About headings move from the display serif to the text font at medium weight, a size smaller to match; the serif stays for the logo and the (i) glyph.
---
 tools/console/app.css | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/tools/console/app.css b/tools/console/app.css
index e5a6321..687c396 100644
--- a/tools/console/app.css
+++ b/tools/console/app.css
@@ -11,7 +11,7 @@
 
   --sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
   --mono: "IBM Plex Mono", "Cascadia Mono", ui-monospace, monospace;
-  --display: "Bodoni Moda", "Didot", "Times New Roman", serif;
+  --display: "Bodoni Moda", "Didot", "Times New Roman", serif;   /* the logo and the (i) glyph only; headings use --sans at 500 */
 
   /* The score is set on light manuscript paper in every theme. */
   --paper:      #f2e9d5;
@@ -429,7 +429,7 @@ button, input, select, textarea { font: inherit; color: inherit; }
 .about-grid { display: flex; flex-direction: column; gap: 16px; container-type: inline-size; }
 .about-projects, .about-addons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; }
 .about-addons { padding-top: 14px; border-top: 1px solid var(--line-soft); }
-.about-project h4 { margin: 0; font: 400 17px/1.2 var(--display); color: var(--ink); letter-spacing: 0; text-transform: none; }
+.about-project h4 { margin: 0; font: 500 15px/1.2 var(--sans); color: var(--ink); letter-spacing: 0; text-transform: none; }
 .about-what { margin: 2px 0 9px; color: var(--muted); font-size: 12px; }
 .about-addons h4 { margin: 0 0 7px; font: 600 10px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--dim); }
 @container (max-width: 760px) { .about-projects, .about-addons { grid-template-columns: minmax(0, 1fr); } }
@@ -490,7 +490,7 @@ body:has(#view-engine:not(.is-hidden)) #engineToggle { background: var(--amber);
   margin: 0 -20px 16px; padding: 10px 20px;
   background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: inset 0 3px 0 var(--amber);
 }
-.engine-title { margin: 0; font: 400 21px/1 var(--display); color: var(--amber); white-space: nowrap; }
+.engine-title { margin: 0; font: 500 19px/1 var(--sans); color: var(--amber); white-space: nowrap; }
 .engine-gear { font-size: 17px; vertical-align: 1px; }
 .engine-sub { margin: 0; color: var(--dim); font-size: 12px; }
 #engineBack { margin-left: auto; }
@@ -558,7 +558,7 @@ body.is-resizing, body.is-resizing * { cursor: col-resize !important; user-selec
   padding: 18px 22px 12px;
   background: inherit;
 }
-.col-head h2 { margin: 0; font: 400 20px/1.2 var(--display); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.col-head h2 { margin: 0; font: 500 18px/1.2 var(--sans); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .take-col .col-head { flex-wrap: wrap; row-gap: 8px; }
 .col-note { white-space: nowrap; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
 
@@ -1054,7 +1054,7 @@ pre.paper { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-br
   flex-direction: column;
   gap: 13px;
 }
-.card h3 { margin: 0; font: 400 16px/1 var(--display); }
+.card h3 { margin: 0; font: 500 15px/1 var(--sans); }
 
 .kv { margin: 0; display: grid; gap: 8px; }
 .kv div { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; min-width: 0; }
@@ -1124,7 +1124,7 @@ pre.paper { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-br
   padding: 18px 14px 12px 18px;
   border-bottom: 1px solid var(--line);
 }
-.lib-head h3 { margin: 0; font: 400 17px/1 var(--display); }
+.lib-head h3 { margin: 0; font: 500 16px/1 var(--sans); }
 .count { font-size: 11px; color: var(--dim); }
 
 .lib-toggle {
@@ -1255,7 +1255,7 @@ pre.paper { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-br
   gap: 10px;
 }
 .panel-head { display: flex; align-items: baseline; gap: 10px; }
-.panel-head h3 { margin: 0; font: 400 16px/1 var(--display); }
+.panel-head h3 { margin: 0; font: 500 15px/1 var(--sans); }
 
 /* Prompt first, lyrics under it, both full width of the column. */
 .word-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-items: start; }
@@ -1321,7 +1321,7 @@ pre.paper { font-size: 12.5px; line-height: 1.65; white-space: pre-wrap; word-br
   min-width: 180px;
   max-width: 460px;
   padding: 4px 9px !important;
-  font: 400 18px/1.2 var(--display) !important;
+  font: 500 17px/1.2 var(--sans) !important;
 }
 
 /* -------------------------------------------------------------- scrollbars */
