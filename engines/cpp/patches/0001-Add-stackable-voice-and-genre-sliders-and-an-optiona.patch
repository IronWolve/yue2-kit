From e75af98f70262c44fbe94a3a4b5cedec4472c72b Mon Sep 17 00:00:00 2001
From: IronWolve <3938589+IronWolve@users.noreply.github.com>
Date: Thu, 24 Sep 2026 13:52:16 -0700
Subject: [PATCH 01/38] Add stackable voice and genre sliders and an optional
 full-precision weight load

Sliders are routed-particle adapters on the four attention projections of
every autoregressive layer, all in float32, summed when several are active,
in both the prefill graph and the static decode graph. The graph size grows
to fit sixteen of them. Weights stored as bfloat16 or float16 can now be
widened to float32 as they load, fused projections included. Two parity
harnesses cover the adapters alone and the backbone with sliders attached.
---
 src/gguf-weights.h         |  43 +++++++-
 src/qwen3-lm.h             |  50 +++++++--
 src/sliders.h              | 213 +++++++++++++++++++++++++++++++++++++
 tests/CMakeLists.txt       |   6 ++
 tests/test-slider-unit.cpp |  68 ++++++++++++
 tests/test-slider.cpp      |  91 ++++++++++++++++
 6 files changed, 462 insertions(+), 9 deletions(-)
 create mode 100644 src/sliders.h
 create mode 100644 tests/test-slider-unit.cpp
 create mode 100644 tests/test-slider.cpp

diff --git a/src/gguf-weights.h b/src/gguf-weights.h
index ce1c67d..c9ff266 100644
--- a/src/gguf-weights.h
+++ b/src/gguf-weights.h
@@ -164,6 +164,28 @@ static bool gf_load(GGUFModel * gf, const char * path) {
     return true;
 }
 
+// Local addition: the console's precision setting. When true, every BF16 or
+// F16 weight loads converted to F32 (exact), so matrix products run F32 x F32
+// instead of rounding their activation input to 16 bits. One instance for
+// the whole process (the store loads modules from another translation unit).
+inline bool g_gf_weights_f32 = false;
+
+static struct ggml_tensor * gf_load_tensor_f32(WeightCtx * wctx, const GGUFModel & gf, const std::string & name);
+
+static bool gf_widen(enum ggml_type t) {
+    return g_gf_weights_f32 && (t == GGML_TYPE_BF16 || t == GGML_TYPE_F16);
+}
+
+// One part of a fused weight, converted to F32 into a staging buffer
+static void gf_push_part_f32(WeightCtx * wctx, struct ggml_tensor * fused, const struct ggml_tensor * src,
+                             const void * raw, size_t offset_bytes) {
+    size_t n   = ggml_nelements(src);
+    auto   buf = std::make_unique<float[]>(n);
+    ggml_get_type_traits(src->type)->to_float(raw, buf.get(), (int64_t) n);
+    wctx->pending.push_back({ fused, buf.get(), n * sizeof(float), offset_bytes });
+    wctx->staging.push_back(std::move(buf));
+}
+
 // Load a tensor from GGUF into the weight context.
 // Returns ggml_tensor (not yet backed by memory; call wctx_alloc after all loads).
 // Tensor shapes are already in ggml order (ne[0]=innermost).
@@ -184,6 +206,9 @@ static struct ggml_tensor * gf_load_tensor(WeightCtx *         wctx,
         fprintf(stderr, "[GGUF] FATAL: tensor '%s' not in meta context\n", name.c_str());
         exit(1);
     }
+    if (gf_widen(src->type) && !(shape_override && n_dims_override > 0)) {
+        return gf_load_tensor_f32(wctx, gf, name);
+    }
 
     int     n_dims;
     int64_t ne[4] = { 1, 1, 1, 1 };
@@ -296,7 +321,8 @@ static struct ggml_tensor * gf_load_qkv_fused(WeightCtx *         wctx,
     int64_t              ne0       = q_src->ne[0];
     int64_t              fused_ne1 = q_src->ne[1] + k_src->ne[1] + v_src->ne[1];
     int64_t              ne[2]     = { ne0, fused_ne1 };
-    struct ggml_tensor * fused     = ggml_new_tensor(wctx->ctx, q_src->type, 2, ne);
+    bool                 widen     = gf_widen(q_src->type);
+    struct ggml_tensor * fused     = ggml_new_tensor(wctx->ctx, widen ? GGML_TYPE_F32 : q_src->type, 2, ne);
 
     size_t row_size = ggml_row_size(q_src->type, ne0);
     size_t q_bytes  = q_src->ne[1] * row_size;
@@ -309,6 +335,13 @@ static struct ggml_tensor * gf_load_qkv_fused(WeightCtx *         wctx,
         return gf.mapping + gf.data_offset + off;
     };
 
+    if (widen) {
+        size_t row_f32 = ggml_row_size(GGML_TYPE_F32, ne0);
+        gf_push_part_f32(wctx, fused, q_src, get_data(q_name), 0);
+        gf_push_part_f32(wctx, fused, k_src, get_data(k_name), q_src->ne[1] * row_f32);
+        gf_push_part_f32(wctx, fused, v_src, get_data(v_name), (q_src->ne[1] + k_src->ne[1]) * row_f32);
+        return fused;
+    }
     wctx->pending.push_back({ fused, get_data(q_name), q_bytes, 0 });
     wctx->pending.push_back({ fused, get_data(k_name), k_bytes, q_bytes });
     wctx->pending.push_back({ fused, get_data(v_name), v_bytes, q_bytes + k_bytes });
@@ -332,7 +365,8 @@ static struct ggml_tensor * gf_load_pair_fused(WeightCtx *         wctx,
 
     int64_t              ne0   = a_src->ne[0];
     int64_t              ne[2] = { ne0, a_src->ne[1] + b_src->ne[1] };
-    struct ggml_tensor * fused = ggml_new_tensor(wctx->ctx, a_src->type, 2, ne);
+    bool                 widen = gf_widen(a_src->type);
+    struct ggml_tensor * fused = ggml_new_tensor(wctx->ctx, widen ? GGML_TYPE_F32 : a_src->type, 2, ne);
 
     size_t row_size = ggml_row_size(a_src->type, ne0);
     size_t a_bytes  = a_src->ne[1] * row_size;
@@ -344,6 +378,11 @@ static struct ggml_tensor * gf_load_pair_fused(WeightCtx *         wctx,
         return gf.mapping + gf.data_offset + off;
     };
 
+    if (widen) {
+        gf_push_part_f32(wctx, fused, a_src, get_data(a_name), 0);
+        gf_push_part_f32(wctx, fused, b_src, get_data(b_name), a_src->ne[1] * ggml_row_size(GGML_TYPE_F32, ne0));
+        return fused;
+    }
     wctx->pending.push_back({ fused, get_data(a_name), a_bytes, 0 });
     wctx->pending.push_back({ fused, get_data(b_name), b_bytes, a_bytes });
     return fused;
